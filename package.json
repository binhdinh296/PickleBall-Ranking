{
  "name": "pickleball-ranking",
  "version": "1.0.0",
  "description": "Hệ thống ranking, giải đấu và livestream Pickleball (Node.js + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "fake-images": "node --env-file-if-exists=.env scripts/fake-images.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  },
  "private": true,
  "engines": {
    "node": ">=22.9"
  }
}
