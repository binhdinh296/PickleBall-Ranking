# Sao chép thành .env và điền giá trị. KHÔNG commit file .env lên Git.

# Môi trường: development | production
NODE_ENV=development
PORT=3000
# Địa chỉ public của website (bắt buộc khi kết nối YouTube), ví dụ https://pickle.example.vn
APP_URL=http://localhost:3000
# Đặt 1 khi chạy sau reverse proxy (Nginx, Cloudflare) để lấy đúng IP người dùng và cookie Secure
TRUST_PROXY=0

# PostgreSQL. Để trống khi chạy `npm run dev` sẽ tự bật PostgreSQL nhúng trong thư mục data/pg
DATABASE_URL=

# Chuỗi bí mật ngẫu nhiên, mỗi chuỗi ≥ 32 ký tự (tạo bằng: openssl rand -hex 32)
SESSION_SECRET=
# Dùng để mã hóa token YouTube, stream key và băm mã OTP. Đổi khóa này sẽ làm mất kết nối YouTube đã lưu.
APP_SECRET=

# Tài khoản quản trị tạo lần đầu. Bỏ trống mật khẩu để hệ thống tự sinh và ghi vào data/initial-admin.txt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# YouTube Data API (OAuth client loại "Web application" trong Google Cloud Console)
# Redirect URI cần khai báo: {APP_URL}/admin/livestream/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Gửi OTP qua eSMS.vn (chọn nhà cung cấp trong CMS > Cấu hình)
ESMS_API_KEY=
ESMS_SECRET_KEY=
# Chỉ dùng khi thử nghiệm trên server production: cho phép OTP giả lập
ALLOW_MOCK_OTP=0
# Chỉ cho bản DEMO (không có dữ liệu thật): hiện mã OTP giả lập ngay trên form
DEMO_SHOW_OTP=0

# ---- Chỉ khi chạy trên Vercel (xem README > Triển khai trên Vercel) ----
# Lưu ảnh/PDF lên Vercel Blob (tự có khi gắn Blob ở tab Storage). Bỏ trống = lưu vào data/uploads
BLOB_READ_WRITE_TOKEN=
# Khóa bảo vệ đường dẫn cron /cron/daily (Vercel Cron tự gửi kèm)
CRON_SECRET=
# 1 = nạp dữ liệu mẫu hư cấu trong bước build khi CSDL trống (chỉ cho bản demo)
SEED_DEMO=0
# 1 = Bật nút DEV "Xem với vai trò" và bảng test /dev (đặt 0 khi có dữ liệu thật để bảo mật)
ENABLE_DEVTOOLS=1
