<%- include('_top') %>
<% const qs = (o) => { const p = new URLSearchParams(); const v = { q, gender, ...o }; Object.keys(v).forEach((k) => { if (v[k]) p.set(k, v[k]); }); return p.toString() ? `?${p}` : ''; }; %>
<form class="toolbar" method="get" action="/admin/vdv" role="search">
  <input class="input grow" type="search" name="q" value="<%= q %>" placeholder="Tìm tên, SĐT, CLB" aria-label="Tìm VĐV" style="flex: 1 1 200px;">
  <select class="input" name="gender" aria-label="Giới tính" style="flex: 0 0 auto; width: auto;"><option value="">Tất cả</option><option value="M" <%= gender === 'M' ? 'selected' : '' %>>Nam</option><option value="F" <%= gender === 'F' ? 'selected' : '' %>>Nữ</option></select>
  <button class="btn" type="submit">Lọc</button>
  <a class="btn btn-brand" href="/admin/vdv/moi"><%- include('../partials/icon', { name: 'plus' }) %>Thêm VĐV</a>
</form>
<p class="tiny faint"><%= total %> vận động viên</p>
<div class="list">
  <% if (!rows.length) { %><div class="list-item faint">Không có VĐV phù hợp.</div><% } %>
  <% rows.forEach((a) => { %>
  <a class="list-item" href="/admin/vdv/<%= a.id %>">
    <%- include('../partials/avatar', { a, size: 44 }) %>
    <span class="main"><strong><%= a.full_name %><%= a.nickname ? ` (${a.nickname})` : '' %></strong><span class="sub"><%= fmt.GENDER_LABEL[a.gender] %> · <%= a.club || '—' %> · <%= a.phone || 'chưa có SĐT' %></span></span>
    <span class="side"><% if (a.featured) { %><span class="chip chip-gold">Nổi bật</span><% } %><% if (!a.visible) { %><span class="chip chip-muted">Ẩn</span><% } %><strong class="tnum"><%= fmt.pts(a.points) %></strong></span>
  </a>
  <% }) %>
</div>
<% if (pages > 1) { %>
<nav class="pager"><% if (page > 1) { %><a href="/admin/vdv<%= qs({ page: page - 1 }) %>">‹</a><% } %><span aria-current="page"><%= page %>/<%= pages %></span><% if (page < pages) { %><a href="/admin/vdv<%= qs({ page: page + 1 }) %>">›</a><% } %></nav>
<% } %>
<%- include('_bottom') %>
