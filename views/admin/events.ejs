<%- include('_top') %>

<div class="row" style="justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
  <div class="row" style="--gap: 6px; align-items: center;">
    <p class="tiny faint at-count" style="margin: 0;"><%= rows.length %> giải đấu</p>
    <span class="guide-tip" data-tip="Bấm Vào quản lý giải để thiết lập nội dung thi đấu, duyệt danh sách VĐV đăng ký, bốc thăm phân nhánh và trao giải vinh danh.">?</span>
  </div>
  <a class="btn btn-brand btn-sm" href="/admin/giai-dau/moi">
    <%- include('../partials/icon', { name: 'plus' }) %>Tạo giải đấu mới
  </a>
</div>

<% if (!rows.length) { %>
  <div class="empty">Chưa có giải đấu nào. Bấm <strong>"+ Tạo giải đấu mới"</strong> ở trên để tạo giải đầu tiên.</div>
<% } else { %>
<div class="table-wrap">
  <table class="data atable">
    <thead>
      <tr>
        <th>Giải đấu & Thời gian</th>
        <th class="c-fit" style="text-align: center;">Nội dung</th>
        <th class="c-fit" style="text-align: center;">Đơn mới</th>
        <th class="c-fit hide-m" style="text-align: center;">Hiển thị</th>
        <th class="c-fit" style="text-align: center;">Tiến độ</th>
        <th class="c-act" style="text-align: right;">Thao tác</th>
      </tr>
    </thead>
    <tbody>
    <% rows.forEach((e) => { %>
      <tr class="at-row" data-href="/admin/giai-dau/<%= e.id %>">
        <td class="c-main">
          <a class="at-who" href="/admin/giai-dau/<%= e.id %>">
            <span class="at-name">
              <strong style="font-size: 15px;"><%= e.name %></strong>
              <span class="at-meta" style="font-size: 12px;">
                <%= fmt.dateVN(e.start_date) %> – <%= fmt.dateVN(e.end_date) %><%= e.venue ? ` · Sân: ${e.venue}` : '' %>
              </span>
            </span>
          </a>
        </td>

        <td class="c-fit tnum" style="text-align: center; vertical-align: middle;">
          <span class="chip" style="font-size: 11px;"><b><%= e.divisions %></b> nội dung</span>
        </td>

        <td class="c-fit tnum" style="text-align: center; vertical-align: middle;">
          <% if (e.new_regs) { %>
            <a class="chip chip-warn" href="/admin/giai-dau/<%= e.id %>" style="font-weight: 700; font-size: 11px;">
              <%= e.new_regs %> đơn mới!
            </a>
          <% } else { %>
            <span class="tiny faint">0</span>
          <% } %>
        </td>

        <td class="c-fit hide-m" style="text-align: center; vertical-align: middle;">
          <span class="chip <%= e.published ? 'chip-ok' : 'chip-muted' %>">
            <%= e.published ? 'Công khai' : 'Nháp' %>
          </span>
        </td>

        <td class="c-fit" style="text-align: center; vertical-align: middle;">
          <span class="chip">
            <%= fmt.EVENT_STATUS_LABEL[e.status] %>
          </span>
        </td>

        <td class="c-act" style="text-align: right; vertical-align: middle;">
          <details class="action-dropdown">
            <summary class="btn btn-sm" aria-label="Thao tác cho giải <%= e.name %>">
              <span>Thao tác</span> <span style="font-size: 10px; opacity: 0.7;">▾</span>
            </summary>
            <div class="dropdown-pop">
              <a class="dropdown-item" href="/admin/giai-dau/<%= e.id %>">
                <%- include('../partials/icon', { name: 'trophy' }) %>
                <span>Vào quản lý giải</span>
              </a>
              <a class="dropdown-item" href="/admin/giai-dau/<%= e.id %>/sua">
                <%- include('../partials/icon', { name: 'edit' }) %>
                <span>Sửa thông tin</span>
              </a>
              <a class="dropdown-item" href="/admin/livestream?giai=<%= e.id %>">
                <%- include('../partials/icon', { name: 'live' }) %>
                <span>Livestream giải</span>
              </a>
              <% if (e.published) { %>
                <a class="dropdown-item" href="/giai-dau/<%= e.slug %>" target="_blank" rel="noopener">
                  <%- include('../partials/icon', { name: 'external' }) %>
                  <span>Xem trên website</span>
                </a>
              <% } %>
              <div class="dropdown-divider"></div>
              <button type="button" class="dropdown-item text-danger" data-modal-target="modal-del-event-<%= e.id %>">
                <%- include('../partials/icon', { name: 'close' }) %>
                <span>Xóa giải đấu</span>
              </button>
            </div>
          </details>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<!-- MODALS XÁC NHẬN XÓA GIẢI ĐẤU -->
<% rows.forEach((e) => { %>
  <div class="admin-modal" id="modal-del-event-<%= e.id %>" role="dialog" aria-modal="true">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <h3 style="margin: 0; font-size: 16px;">Xóa giải đấu: <%= e.name %></h3>
        <button type="button" class="btn btn-sm" data-modal-close aria-label="Đóng">✕</button>
      </div>
      <div class="admin-modal-body">
        <p>Bạn có chắc chắn muốn xóa giải <strong><%= e.name %></strong> cùng toàn bộ nội dung thi đấu, đăng ký, sơ đồ thi đấu và luồng phát livestream?</p>
        <p class="small text-danger" style="margin-top: 8px;">Thao tác này không thể hoàn tác.</p>
      </div>
      <div class="admin-modal-actions">
        <button type="button" class="btn btn-sm" data-modal-close>Hủy</button>
        <form method="post" action="/admin/giai-dau/<%= e.id %>/xoa" style="margin: 0;">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-danger">Xác nhận xóa vĩnh viễn</button>
        </form>
      </div>
    </div>
  </div>
<% }) %>
<% } %>

<%- include('_bottom') %>