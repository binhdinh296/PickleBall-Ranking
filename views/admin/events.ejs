<%- include('_top') %>
<%
  // Danh sách giải: nhìn nhanh giải nào đang diễn ra / sắp tới, đơn chờ duyệt, tiến độ thi đấu; vào điều hành bằng 1 nút.
  const ic = (n) => include('../partials/icon', { name: n });
  const filters = [['', 'Tất cả', stats.total], ['ongoing', 'Đang diễn ra', stats.ongoing], ['upcoming', 'Sắp tới', stats.upcoming], ['ended', 'Đã kết thúc', stats.ended]];
  const daysTo = (d) => Math.ceil((new Date(d) - new Date(fmt.today())) / 86400000);
%>
<link rel="stylesheet" href="/static/css/event-hub.css?v=<%= locals.assetV || '' %>">

<div class="eh-kpis el-kpis">
  <div class="eh-kpi"><b><%= stats.total %></b><span>Giải đấu</span></div>
  <div class="eh-kpi<%= stats.ongoing ? ' is-live' : '' %>"><b><%= stats.ongoing %></b><span>Đang diễn ra</span></div>
  <div class="eh-kpi"><b><%= stats.openReg %></b><span>Đang mở đăng ký</span></div>
  <div class="eh-kpi<%= stats.newRegs ? ' is-warn' : '' %>"><b><%= stats.newRegs %></b><span>Đơn chờ duyệt</span></div>
  <div class="eh-kpi<%= stats.live ? ' is-live' : '' %>"><b><%= stats.live %></b><span>Trận đang live</span></div>
</div>

<div class="toolbar el-bar">
  <nav class="tabs grow" aria-label="Lọc theo trạng thái">
    <% filters.forEach(([k, l, n]) => { %><a class="tab" href="/admin/giai-dau<%= k ? `?loc=${k}` : '' %>" aria-current="<%= filter === k %>"><%= l %> <small><%= n %></small></a><% }) %>
  </nav>
  <a class="btn btn-brand btn-sm" href="/admin/giai-dau/moi"><%- ic('plus') %>Tạo giải đấu</a>
</div>

<% if (!rows.length) { %>
  <div class="empty"><%= stats.total ? 'Không có giải nào ở trạng thái này.' : 'Chưa có giải đấu nào. Bấm "+ Tạo giải đấu" để tạo giải đầu tiên.' %></div>
<% } else { %>
<div class="table-wrap">
  <table class="data atable el-table">
    <thead><tr>
      <th>Giải đấu</th>
      <th class="c-fit hide-m">Trạng thái</th>
      <th class="c-fit">Đăng ký</th>
      <th class="c-fit hide-m">Thi đấu</th>
      <th class="c-act" style="text-align: right;"><span class="sr-only">Thao tác</span></th>
    </tr></thead>
    <tbody>
    <% rows.forEach((e) => { const pct = e.matches ? Math.round(e.done_matches / e.matches * 100) : 0; const dd = daysTo(e.start_date); %>
      <tr class="at-row" data-href="/admin/giai-dau/<%= e.id %>">
        <td class="c-main">
          <a class="el-name" href="/admin/giai-dau/<%= e.id %>"><%= e.name %></a>
          <span class="at-meta"><%= fmt.dateVN(e.start_date) %> – <%= fmt.dateVN(e.end_date) %><%= e.venue ? ` · ${e.venue}` : '' %> · <%= e.divisions %> nội dung
            <span class="show-m"> · <%= fmt.EVENT_STATUS_LABEL[e.status] %></span></span>
        </td>
        <td class="c-fit hide-m">
          <div class="el-status">
            <span class="chip eh-status eh-status-<%= e.status %>"><%= e.status === 'upcoming' && dd > 0 ? `Còn ${dd} ngày` : fmt.EVENT_STATUS_LABEL[e.status] %></span>
            <span class="el-flags">
              <span class="el-flag<%= e.registration_open ? ' is-on' : '' %>" title="<%= e.registration_open ? 'Đang mở đăng ký' : 'Đã đóng đăng ký' %>">ĐK <%= e.registration_open ? 'mở' : 'đóng' %></span>
              <span class="el-flag<%= e.published ? ' is-on' : '' %>" title="<%= e.published ? 'Đang công khai trên website' : 'Đang ẩn (bản nháp)' %>"><%= e.published ? 'Công khai' : 'Nháp' %></span>
            </span>
          </div>
        </td>
        <td class="c-fit">
          <div class="el-regs">
            <b class="tnum"><%= e.approved_regs %></b><span class="tiny faint">đã duyệt</span>
            <% if (e.new_regs) { %><a class="chip chip-warn el-new" href="/admin/giai-dau/<%= e.id %>"><%= e.new_regs %> chờ duyệt</a><% } %>
          </div>
        </td>
        <td class="c-fit hide-m">
          <% if (e.matches) { %>
          <div class="el-prog" title="<%= e.done_matches %>/<%= e.matches %> trận đã xong">
            <span class="el-bar-track"><i style="width: <%= pct %>%;"></i></span>
            <span class="tiny tnum"><%= e.done_matches %>/<%= e.matches %><% if (e.live_matches) { %> · <b class="text-live"><%= e.live_matches %> live</b><% } %></span>
          </div>
          <% } else { %><span class="tiny faint">Chưa bốc thăm</span><% } %>
        </td>
        <td class="c-act">
          <div class="el-acts">
            <a class="btn btn-sm btn-brand" href="/admin/giai-dau/<%= e.id %>">Điều hành<span class="hide-m"> →</span></a>
            <details class="action-dropdown">
              <summary class="btn btn-sm" aria-label="Thêm thao tác cho <%= e.name %>">⋯</summary>
              <div class="dropdown-pop">
                <a class="dropdown-item" href="/admin/giai-dau/<%= e.id %>/sua"><%- ic('edit') %><span>Sửa thông tin giải</span></a>
                <a class="dropdown-item" href="/admin/giai-dau/<%= e.id %>/noi-dung/moi"><%- ic('plus') %><span>Thêm nội dung thi đấu</span></a>
                <a class="dropdown-item" href="/admin/livestream?giai=<%= e.id %>"><%- ic('live') %><span>Livestream</span></a>
                <% if (e.published) { %><a class="dropdown-item" href="/giai-dau/<%= e.slug %>" target="_blank" rel="noopener"><%- ic('external') %><span>Xem trên website</span></a><% } %>
                <% if (user.role === 'admin') { %>
                <div class="dropdown-divider"></div>
                <form method="post" action="/admin/giai-dau/<%= e.id %>/xoa" data-confirm="Xoá giải &quot;<%= e.name %>&quot; cùng toàn bộ nội dung, đăng ký, nhánh đấu, livestream? Không thể hoàn tác.">
                  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                  <button class="dropdown-item text-danger" type="submit"><%- ic('close') %><span>Xoá giải đấu</span></button>
                </form>
                <% } %>
              </div>
            </details>
          </div>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('_bottom') %>
