<%- include('_top') %>
<div class="toolbar"><a class="btn btn-brand" href="/admin/giai-dau/moi"><%- include('../partials/icon', { name: 'plus' }) %>Tạo giải đấu</a></div>
<% if (!rows.length) { %><div class="empty">Chưa có giải đấu. Bấm "Tạo giải đấu" để bắt đầu.</div><% } else { %>
<div class="table-wrap">
  <table class="data atable">
    <thead>
      <tr>
        <th>Giải đấu</th>
        <th class="num c-fit">Nội dung</th>
        <th class="num c-fit">ĐK mới</th>
        <th class="c-fit hide-m">Hiển thị</th>
        <th class="c-fit">Trạng thái</th>
        <th class="c-act" style="text-align: right;">Thao tác</th>
      </tr>
    </thead>
    <tbody>
    <% rows.forEach((e) => { %>
      <tr class="at-row">
        <td class="c-main">
          <a class="at-who" href="/admin/giai-dau/<%= e.id %>">
            <span class="at-name">
              <strong><%= e.name %></strong>
              <span class="at-meta"><%= fmt.dateVN(e.start_date) %> – <%= fmt.dateVN(e.end_date) %></span>
            </span>
          </a>
        </td>
        <td class="num c-fit tnum"><b><%= e.divisions %></b> nội dung</td>
        <td class="num c-fit tnum"><% if (e.new_regs) { %><a class="chip chip-warn" href="/admin/giai-dau/<%= e.id %>"><%= e.new_regs %> mới</a><% } else { %><span class="faint">0</span><% } %></td>
        <td class="c-fit hide-m"><span class="chip <%= e.published ? 'chip-ok' : 'chip-muted' %>"><%= e.published ? 'Công khai' : 'Nháp' %></span></td>
        <td class="c-fit"><span class="chip"><%= fmt.EVENT_STATUS_LABEL[e.status] %></span></td>
        <td class="c-act" style="text-align: right;">
          <a class="btn btn-sm btn-brand" href="/admin/giai-dau/<%= e.id %>">Quản lý giải →</a>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('_bottom') %>
