<%- include('_top') %>
<div class="toolbar"><a class="btn btn-brand" href="/admin/giai-dau/moi"><%- include('../partials/icon', { name: 'plus' }) %>Tạo giải đấu</a></div>
<% if (!rows.length) { %><div class="empty">Chưa có giải đấu.</div><% } else { %>
<div class="table-wrap">
  <table class="data atable">
    <thead><tr><th>Giải đấu</th><th class="num c-fit">ĐK mới</th><th class="c-fit hide-m">Hiển thị</th><th class="c-fit" style="text-align: right;">Trạng thái</th></tr></thead>
    <tbody>
    <% rows.forEach((e) => { %>
      <tr class="at-row" data-href="/admin/giai-dau/<%= e.id %>">
        <td class="c-main"><a class="at-who" href="/admin/giai-dau/<%= e.id %>"><span class="at-name">
          <strong><%= e.name %></strong>
          <span class="at-meta"><%= fmt.dateVN(e.start_date) %> – <%= fmt.dateVN(e.end_date) %> · <%= e.divisions %> nội dung<% if (!e.published) { %><span class="show-m"> · Nháp</span><% } %></span>
        </span></a></td>
        <td class="num c-fit tnum"><% if (e.new_regs) { %><span class="chip chip-warn"><%= e.new_regs %></span><% } else { %><span class="faint">0</span><% } %></td>
        <td class="c-fit hide-m"><span class="chip <%= e.published ? 'chip-ok' : 'chip-muted' %>"><%= e.published ? 'Công khai' : 'Nháp' %></span></td>
        <td class="c-fit" style="text-align: right;"><span class="chip"><%= fmt.EVENT_STATUS_LABEL[e.status] %></span></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('_bottom') %>
