<%- include('_top', { back: `/admin/giai-dau/${d.event_id}` }) %>
<%
  // Bảng vinh danh dạng bảng: mỗi dòng 1 hạng (Vô địch, Giải nhì, 2 Đồng giải ba); cột VĐV 1 / VĐV 2 (nội dung đơn chỉ 1 cột).
  // Mỗi ô VĐV: tên hiển thị + ô tìm hồ sơ để gắn (danh sách gợi ý nổi lên, không đẩy bảng dài ra).
  const label = { 1: 'Vô địch', 2: 'Giải nhì', 3: 'Đồng giải ba' };
  const medal = { 1: '🥇', 2: '🥈', 3: '🥉' };
  const single = fmt.isSingle(d);
  const sides = single ? [1] : [1, 2];
  const linkedMap = locals.linked || {};
%>
<link rel="stylesheet" href="/static/css/honors-admin.css?v=<%= locals.assetV || '' %>">
<div class="toolbar hn-bar">
  <form method="post" action="/admin/noi-dung/<%= d.id %>/vinh-danh/goi-y"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-sm" type="submit"><%- include('../partials/icon', { name: 'trophy' }) %>Lấy tự động từ nhánh đấu</button></form>
  <% if (suggestion) { %><span class="chip chip-warn">Đã điền gợi ý từ nhánh đấu · kiểm tra rồi bấm Lưu</span><% } %>
  <a class="btn btn-sm" href="/admin/noi-dung/<%= d.id %>/nhanh-dau" style="margin-left: auto;"><%- include('../partials/icon', { name: 'bracket' }) %>Nhánh đấu</a>
</div>
<form class="form" method="post" action="/admin/noi-dung/<%= d.id %>/vinh-danh">
  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
  <div class="hn-wrap">
    <table class="hn-table">
      <thead><tr>
        <th class="hn-place">Hạng</th>
        <% sides.forEach((n) => { %><th><%= single ? 'Vận động viên' : `VĐV ${n}` %></th><% }) %>
      </tr></thead>
      <tbody>
      <% slots.forEach((h, i) => { %>
        <tr class="hn-row hn-p<%= h.place %>">
          <td class="hn-place" data-label="Hạng">
            <input type="hidden" name="place" value="<%= h.place %>">
            <span class="hn-medal" aria-hidden="true"><%= medal[h.place] %></span><b><%= label[h.place] %></b>
          </td>
          <% sides.forEach((n) => { const nameId = `n${i}_${n}`; const aid = h[`athlete${n}_id`]; %>
          <td class="hn-cell" data-label="<%= single ? 'Vận động viên' : `VĐV ${n}` %>">
            <input class="input hn-name" id="<%= nameId %>" name="name<%= n %>" value="<%= h[`name${n}`] || '' %>" maxlength="80" placeholder="Tên hiển thị<%= n === 1 ? '' : ' (tuỳ chọn)' %>" aria-label="<%= label[h.place] %> · tên <%= single ? 'VĐV' : `VĐV ${n}` %>">
            <div class="athlete-search hn-search" data-athlete-search data-name-field="<%= nameId %>">
              <input type="hidden" name="athlete<%= n %>_id" value="<%= aid || '' %>">
              <div class="hn-search-row">
                <input class="input<%= aid ? ' is-linked' : '' %>" type="search" value="<%= aid ? (linkedMap[aid] || `Hồ sơ #${aid}`) : '' %>" placeholder="Gắn hồ sơ VĐV: gõ tên…" aria-label="Tìm hồ sơ <%= label[h.place] %> <%= single ? '' : `VĐV ${n}` %>">
                <button type="button" class="btn btn-xs" data-clear aria-label="Bỏ gắn hồ sơ" title="Bỏ gắn hồ sơ">✕</button>
              </div>
              <ul></ul>
            </div>
          </td>
          <% }) %>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <p class="tiny muted" style="margin: 0;">Dòng để trống tên<%= single ? '' : ' VĐV 1' %> sẽ không được lưu. Gắn hồ sơ để tên trên trang vinh danh dẫn tới trang cá nhân VĐV.</p>
  <div class="form-actions hn-actions"><button class="btn btn-brand" type="submit">Lưu bảng vinh danh</button></div>
</form>
<%- include('_bottom') %>
