<% const org = user.role === 'organizer'; %>
<%- include('_top', { back: org ? null : '/admin/giai-dau' }) %>
<%
  // Trung tâm điều hành 1 giải: trạng thái + bật/tắt nhanh, việc cần làm, tiến độ từng nội dung (5 bước) và việc tiếp theo.
  const ic = (n) => include('../partials/icon', { name: n });
  const STEPS = ['Đăng ký', 'Chốt danh sách', 'Bốc thăm', 'Thi đấu', 'Vinh danh'];
  const stepInfo = (d, i) => {
    const u = fmt.unitLabel(d);
    return [
      `${d.approvedRegs} ${u}${d.newRegs ? ` · ${d.newRegs} chờ` : ''}`,
      d.teams_locked || d.matchCount ? `${d.teamCount} ${u}` : d.teamCount ? `${d.teamCount} ${u} · chưa chốt` : 'Chưa chốt',
      d.matchCount ? `${d.realMatches} trận` : 'Chưa bốc',
      d.matchCount ? `${d.doneMatches}/${d.realMatches}${d.liveMatches ? ` · ${d.liveMatches} live` : ''}` : '—',
      d.honorCount ? 'Đã trao' : d.finished ? 'Sẵn sàng' : '—',
    ][i];
  };
  // Việc cần làm của cả giải, gom theo nội dung
  const todos = [];
  ev.divisions.forEach((d) => {
    const base = `/admin/noi-dung/${d.id}`;
    if (d.newRegs) todos.push({ tone: 'warn', text: `${d.newRegs} đơn đăng ký mới chờ duyệt`, d, href: `${base}/dang-ky?status=new`, btn: 'Duyệt' });
    if (d.liveMatches) todos.push({ tone: 'live', text: `${d.liveMatches} trận đang thi đấu`, d, href: `${base}/nhanh-dau`, btn: 'Theo dõi' });
    if (!d.matchCount && d.step === 2) todos.push({ tone: 'info', text: `${d.approvedRegs} ${fmt.unitLabel(d)} đã duyệt, chưa chốt danh sách`, d, href: `${base}/nhanh-dau`, btn: 'Chốt' });
    if (!d.matchCount && d.step === 3) todos.push({ tone: 'info', text: 'Đã chốt danh sách, chưa bốc thăm', d, href: `${base}/nhanh-dau`, btn: 'Bốc thăm' });
    if (d.finished && !d.honorCount) todos.push({ tone: 'ok', text: 'Đã đấu xong, chưa trao giải', d, href: `${base}/vinh-danh`, btn: 'Vinh danh' });
  });
  const totalReal = ev.divisions.reduce((s, d) => s + d.realMatches, 0);
  const totalDone = ev.divisions.reduce((s, d) => s + d.doneMatches, 0);
%>
<link rel="stylesheet" href="/static/css/event-hub.css?v=<%= locals.assetV || '' %>">

<!-- 1. ĐẦU TRANG: trạng thái + bật/tắt nhanh + thao tác -->
<section class="card eh-head">
  <div class="eh-head-main">
    <p class="small muted eh-when"><%- ic('calendar') %><b><%= fmt.dateVN(ev.start_date) %> – <%= fmt.dateVN(ev.end_date) %></b><span>·</span><%- ic('pin') %><%= ev.venue || 'Chưa nhập địa điểm' %></p>
    <div class="eh-switches">
      <span class="chip eh-status eh-status-<%= ev.status %>"><%= fmt.EVENT_STATUS_LABEL[ev.status] %></span>
      <form method="post" action="/admin/giai-dau/<%= ev.id %>/nhanh">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="field" value="registration_open"><input type="hidden" name="value" value="<%= ev.registration_open ? 0 : 1 %>">
        <button type="submit" class="eh-toggle<%= ev.registration_open ? ' is-on' : '' %>" title="Bấm để <%= ev.registration_open ? 'đóng' : 'mở' %> đăng ký"><i></i><%= ev.registration_open ? 'Đang mở đăng ký' : 'Đã đóng đăng ký' %></button>
      </form>
      <% if (!org) { %>
      <form method="post" action="/admin/giai-dau/<%= ev.id %>/nhanh"<% if (ev.published) { %> data-confirm="Ẩn giải khỏi website? VĐV sẽ không xem được trang giải."<% } %>>
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="field" value="published"><input type="hidden" name="value" value="<%= ev.published ? 0 : 1 %>">
        <button type="submit" class="eh-toggle<%= ev.published ? ' is-on' : '' %>" title="Bấm để <%= ev.published ? 'ẩn khỏi' : 'công khai lên' %> website"><i></i><%= ev.published ? 'Công khai trên web' : 'Đang ẩn (nháp)' %></button>
      </form>
      <% } else { %>
      <span class="chip <%= ev.published ? 'chip-ok' : 'chip-warn' %>"><%= ev.published ? 'Công khai' : 'Chờ quản trị viên duyệt' %></span>
      <% } %>
    </div>
  </div>
  <div class="eh-actions">
    <a class="btn btn-sm" href="/admin/giai-dau/<%= ev.id %>/sua"><%- ic('edit') %>Sửa giải</a>
    <% if (!org) { %><a class="btn btn-sm" href="/admin/livestream?giai=<%= ev.id %>"><%- ic('live') %>Livestream</a><% } %>
    <% if (ev.published) { %><a class="btn btn-sm" href="/giai-dau/<%= ev.slug %>" target="_blank" rel="noopener"><%- ic('external') %>Xem web</a><% } %>
    <% if (user.role === 'admin') { %>
    <form class="inline-form" method="post" action="/admin/giai-dau/<%= ev.id %>/xoa" data-confirm="Xoá giải &quot;<%= ev.name %>&quot; cùng toàn bộ nội dung, đăng ký, nhánh đấu và vinh danh? Không thể hoàn tác.">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-danger" type="submit" title="Xoá giải"><%- ic('close') %><span class="hide-m">Xoá</span></button>
    </form>
    <% } %>
  </div>

  <% if (locals.shortRegUrl) { %>
  <div class="eh-link">
    <span class="small"><b>Link đăng ký cho VĐV</b> <span class="guide-tip" data-tip="Gửi link này vào nhóm Zalo/Facebook để VĐV tự đăng ký.">?</span></span>
    <div class="copy-bar"><input class="input tnum" id="short-reg-url" readonly value="<%= shortRegUrl %>"><button type="button" class="btn btn-sm" data-copy="short-reg-url">Chép link</button></div>
  </div>
  <% } %>

  <div class="eh-kpis">
    <div class="eh-kpi"><b><%= stats.divisions %></b><span>Nội dung</span></div>
    <div class="eh-kpi"><b class="text-ok"><%= stats.approvedRegs %></b><span>Đăng ký đã duyệt</span></div>
    <div class="eh-kpi<%= stats.newRegs ? ' is-warn' : '' %>"><b><%= stats.newRegs %></b><span>Đơn chờ duyệt</span></div>
    <div class="eh-kpi"><b><%= totalDone %><small>/<%= totalReal %></small></b><span>Trận đã xong</span></div>
    <div class="eh-kpi<%= stats.liveMatches ? ' is-live' : '' %>"><b><%= stats.liveMatches %></b><span>Đang live</span></div>
  </div>
</section>

<!-- 2. VIỆC CẦN LÀM -->
<% if (ev.divisions.length) { %>
<section class="card eh-todo">
  <h2 class="section-title">Việc cần làm <span class="chip"><%= todos.length %></span></h2>
  <% if (!todos.length) { %>
    <p class="small muted" style="margin: 0;">✓ Không có việc nào đang chờ. Theo dõi tiến độ từng nội dung bên dưới.</p>
  <% } else { %>
  <ul class="eh-todo-list">
    <% todos.forEach((t) => { %>
    <li class="eh-todo-item is-<%= t.tone %>">
      <span class="eh-dot" aria-hidden="true"></span>
      <span class="eh-todo-txt"><b><%= t.d.name %></b><span><%= t.text %></span></span>
      <a class="btn btn-sm<%= t.tone === 'warn' || t.tone === 'info' ? ' btn-brand' : '' %>" href="<%= t.href %>"><%= t.btn %> →</a>
    </li>
    <% }) %>
  </ul>
  <% } %>
</section>
<% } %>

<!-- 3. TIẾN ĐỘ TỪNG NỘI DUNG -->
<div class="eh-sec-head">
  <h2 class="section-title" style="margin: 0;">Nội dung thi đấu (<%= ev.divisions.length %>)</h2>
  <a class="btn btn-brand btn-sm" href="/admin/giai-dau/<%= ev.id %>/noi-dung/moi"><%- ic('plus') %>Thêm nội dung</a>
</div>

<% if (!ev.divisions.length) { %>
  <div class="empty">Chưa có nội dung thi đấu. Bấm <b>"+ Thêm nội dung"</b> (vd. "Đôi nam 6.5", "Đơn nữ tự do") để bắt đầu nhận đăng ký.</div>
<% } else { %>
<div class="eh-divs">
  <% ev.divisions.forEach((d) => { const base = `/admin/noi-dung/${d.id}`; %>
  <article class="card eh-div">
    <div class="eh-div-info">
      <a class="eh-div-name" href="<%= base %>/<%= d.step >= 3 ? 'nhanh-dau' : 'dang-ky' %>"><%= d.name %></a>
      <span class="tiny faint"><%= [fmt.categoryLabel(d), fmt.formatLabel(d.format), d.max_teams ? `Tối đa ${d.max_teams} ${fmt.unitLabel(d)}` : null, d.max_total_points && !fmt.isSingle(d) ? `Tổng ≤ ${fmt.pts(d.max_total_points)}` : null].filter(Boolean).join(' · ') %></span>
    </div>

    <ol class="eh-steps" aria-label="Tiến độ <%= d.name %>">
      <% STEPS.forEach((label, i) => { const n = i + 1; const state = n < d.step || (n === 5 && d.honorCount) ? 'done' : n === d.step ? 'now' : 'todo'; %>
      <li class="eh-step is-<%= state %>"<%- state === 'now' ? ' aria-current="step"' : '' %>>
        <span class="eh-step-dot"><%= state === 'done' ? '✓' : n %></span>
        <span class="eh-step-txt"><b><%= label %></b><small><%= stepInfo(d, i) %></small></span>
      </li>
      <% }) %>
    </ol>

    <div class="eh-div-acts">
      <a class="btn btn-sm<%= d.next.primary ? ' btn-brand' : '' %> eh-next" href="<%= d.next.href %>"><%= d.next.label %> →</a>
      <nav class="eh-links" aria-label="Trang của <%= d.name %>">
        <a href="<%= base %>/dang-ky" title="Đăng ký"><%- ic('users') %><span>Đăng ký</span><% if (d.newRegs) { %><em><%= d.newRegs %></em><% } %></a>
        <a href="<%= base %>/nhanh-dau" title="Nhánh đấu"><%- ic('bracket') %><span>Nhánh đấu</span></a>
        <a href="<%= base %>/vinh-danh" title="Vinh danh"><%- ic('trophy') %><span>Vinh danh</span></a>
        <a href="<%= base %>/sua" title="Cài đặt nội dung"><%- ic('settings') %><span>Cài đặt</span></a>
      </nav>
    </div>
  </article>
  <% }) %>
</div>
<% } %>

<%- include('_bottom') %>
