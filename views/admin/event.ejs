<% const org = user.role === 'organizer'; %>
<%- include('_top', { back: org ? null : '/admin/giai-dau' }) %>
<div class="card card-pad stack" style="--gap: 12px;">
  <div class="row" style="--gap: 8px;">
    <span class="chip <%= ev.published ? 'chip-ok' : org ? 'chip-warn' : 'chip-muted' %>"><%= ev.published ? 'Công khai' : org ? 'Chờ duyệt' : 'Nháp' %></span>
    <span class="chip"><%= fmt.EVENT_STATUS_LABEL[ev.status] %></span>
    <span class="chip <%= ev.registration_open ? 'chip-ok' : 'chip-muted' %>"><%= ev.registration_open ? 'Đang mở đăng ký' : 'Đóng đăng ký' %></span>
  </div>
  <p class="muted small"><%= fmt.dateVN(ev.start_date) %> – <%= fmt.dateVN(ev.end_date) %> · <%= ev.venue || 'chưa nhập sân' %></p>
  <div class="row" style="--gap: 8px;">
    <a class="btn btn-sm" href="/admin/giai-dau/<%= ev.id %>/sua"><%- include('../partials/icon', { name: 'edit' }) %>Sửa thông tin</a>
    <% if (!org) { %><a class="btn btn-sm" href="/admin/livestream?giai=<%= ev.id %>"><%- include('../partials/icon', { name: 'live' }) %>Livestream</a><% } %>
    <% if (ev.published) { %><a class="btn btn-sm" href="/giai-dau/<%= ev.slug %>" target="_blank" rel="noopener"><%- include('../partials/icon', { name: 'external' }) %>Xem trang giải</a><% } %>
  </div>
  <% if (locals.shortRegUrl) { %>
  <div class="field" style="max-width: 620px;">
    <label for="short-reg-url">Link đăng ký cho vận động viên</label>
    <div class="copy-row"><input class="input" id="short-reg-url" readonly value="<%= shortRegUrl %>"><button type="button" class="btn btn-sm" data-copy="short-reg-url">Chép</button></div>
    <span class="hint"><%= ev.published ? 'Gửi link này vào nhóm Zalo/Facebook để VĐV tự đăng ký. Đăng ký mới hiện ở nút "Đăng ký" của từng nội dung.' : 'Link nhận đăng ký sau khi quản trị viên duyệt công khai giải. Trước đó người mở link sẽ thấy "chưa mở đăng ký".' %></span>
  </div>
  <% } %>
</div>
<div class="row" style="justify-content: space-between;"><h2 class="section-title">Nội dung thi đấu</h2><a class="btn btn-brand btn-sm" href="/admin/giai-dau/<%= ev.id %>/noi-dung/moi"><%- include('../partials/icon', { name: 'plus' }) %>Thêm nội dung</a></div>
<% if (!ev.divisions.length) { %><div class="empty">Chưa có nội dung. Thêm nội dung (ví dụ "Đôi nam newbie", "Hỗn hợp 5.3") để mở đăng ký.</div><% } %>
<% if (ev.divisions.length) { %>
<div class="table-wrap">
  <table class="data atable">
    <thead><tr><th>Nội dung</th><th class="num c-fit">ĐK mới</th><th class="num c-fit">Đội</th><th class="num c-fit hide-m">Trận</th></tr></thead>
    <tbody>
    <% ev.divisions.forEach((d) => { %>
      <tr class="at-row">
        <td class="c-main"><button type="button" class="at-who" data-row-toggle aria-expanded="false" aria-controls="dv<%= d.id %>"><span class="at-name">
          <strong><%= d.name %></strong>
          <span class="at-meta"><%= [d.format === 'roundrobin' ? 'Vòng tròn' : 'Loại trực tiếp', d.max_teams ? `Tối đa ${d.max_teams}` : null, d.max_total_points ? `Tổng ≤ ${fmt.pts(d.max_total_points)}` : null, fmt.GENDER_RULE_LABEL[d.gender_rule]].filter(Boolean).join(' · ') %></span>
        </span></button></td>
        <td class="num c-fit tnum"><% if (d.newRegs) { %><a class="chip chip-warn" href="/admin/noi-dung/<%= d.id %>/dang-ky?status=new"><%= d.newRegs %></a><% } else { %><span class="faint">0</span><% } %></td>
        <td class="num c-fit tnum"><b><%= d.approvedRegs %></b><% if (d.max_teams) { %><span class="faint small">/<%= d.max_teams %></span><% } %></td>
        <td class="num c-fit tnum hide-m"><%= d.matchCount %></td>
      </tr>
      <tr class="at-detail" id="dv<%= d.id %>" hidden>
        <td colspan="4"><div class="at-detail-in">
          <% if (d.subtitle) { %><span class="small muted"><%= d.subtitle %></span><% } %>
          <div class="action-grid">
            <a class="btn btn-sm" href="/admin/noi-dung/<%= d.id %>/dang-ky">Đăng ký</a>
            <a class="btn btn-sm" href="/admin/noi-dung/<%= d.id %>/nhanh-dau">Nhánh đấu</a>
            <a class="btn btn-sm" href="/admin/noi-dung/<%= d.id %>/vinh-danh">Vinh danh</a>
            <a class="btn btn-sm" href="/admin/noi-dung/<%= d.id %>/sua">Sửa</a>
          </div>
        </div></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<p class="tiny faint">Bấm tên nội dung để mở Đăng ký, Nhánh đấu, Vinh danh, Sửa. "Đội" là số đội đã duyệt.</p>
<% } %>
<%- include('_bottom') %>
