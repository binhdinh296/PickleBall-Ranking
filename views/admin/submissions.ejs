<%- include('_top') %>
<%
  const ip = (n) => include('../partials/icon', { name: n });
  const meta = (s) => [fmt.GENDER_LABEL[s.gender], s.club, s.hometown].filter(Boolean).join(' · ');
  const who = (s, extra = '') => `${include('../partials/avatar', { a: s, size: 36 })}<span class="at-name"><strong>${fmt.esc(s.full_name)}${s.nickname ? ` <small>(${fmt.esc(s.nickname)})</small>` : ''}</strong><span class="at-meta">${fmt.esc(meta(s))}</span>${extra ? `<span class="at-meta">${fmt.esc(extra)}</span>` : ''}</span>`;
  const reviewed = (s) => [`${fmt.SUB_STATUS_LABEL[s.status]}${s.reviewed_by ? ` bởi ${s.reviewed_by}` : ''}`, s.reviewed_at && fmt.dateTimeVN(s.reviewed_at), s.admin_note].filter(Boolean).join(' · ');
%>
<div class="row" style="align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px;">
  <nav class="tabs grow" aria-label="Trạng thái đơn">
    <% [['pending', 'Chờ duyệt'], ['approved', 'Đã duyệt'], ['rejected', 'Từ chối']].forEach(([k, l]) => { %><a class="tab" href="?status=<%= k %>" aria-current="<%= status === k %>"><%= l %> <span class="count">(<%= counts[k] || 0 %>)</span></a><% }) %>
  </nav>
  <span class="guide-tip" data-tip="Sửa điểm trực tiếp trong ô nếu cần, sau đó bấm Thao tác để duyệt hoặc từ chối đơn. Có thể tích chọn nhiều đơn để duyệt hoặc từ chối hàng loạt.">?</span>
</div>
<% if (!rows.length) { %><div class="empty">Không có đơn nào.</div><% } else if (status === 'pending') { %>
<form method="post" action="/admin/don-cham-trinh/hang-loat" data-bulk-form>
  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
  <%# Nút mặc định bị tắt: nhấn Enter trong ô điểm không vô tình gửi nút của dòng khác %>
  <button type="submit" disabled hidden aria-hidden="true" tabindex="-1"></button>
  <div class="table-wrap">
    <table class="data atable">
      <thead><tr>
        <th class="c-chk"><input type="checkbox" data-check-all aria-label="Chọn tất cả"></th>
        <th>Vận động viên</th>
        <th class="num c-fit hide-m">Tự chấm</th>
        <th class="num c-fit">Điểm duyệt</th>
        <th class="c-act" style="text-align: right;">Thao tác</th>
      </tr></thead>
      <tbody>
      <% rows.forEach((s) => { %>
        <tr class="at-row">
          <td class="c-chk"><input type="checkbox" name="ids" value="<%= s.id %>" data-check-item aria-label="Chọn <%= s.full_name %>"></td>
          <td class="c-main">
            <div class="at-who">
              <%- who(s) %>
            </div>
          </td>
          <td class="num c-fit c-sub tnum hide-m"><%= fmt.pts(s.points) %></td>
          <td class="num c-fit"><label class="sr-only" for="p<%= s.id %>">Điểm duyệt cho <%= s.full_name %></label><input class="input tnum at-pts" id="p<%= s.id %>" name="points_<%= s.id %>" inputmode="decimal" value="<%= fmt.pts(s.points) %>" data-self="<%= fmt.pts(s.points) %>" autocomplete="off"></td>
          <td class="c-act" style="text-align: right; vertical-align: middle;">
            <details class="action-dropdown">
              <summary class="btn btn-sm" aria-label="Thao tác cho <%= s.full_name %>">
                <span>Thao tác</span> <span style="font-size: 10px; opacity: 0.7;">▾</span>
              </summary>
              <div class="dropdown-pop">
                <button type="button" class="dropdown-item" data-modal-target="modal-sub-detail-<%= s.id %>">
                  <%- ip('edit') %>
                  <span>Xem chi tiết</span>
                </button>
                <div class="dropdown-divider"></div>
                <button type="button" class="dropdown-item text-ok" data-modal-target="modal-sub-approve-<%= s.id %>">
                  <%- ip('check') %>
                  <span>Duyệt đơn này</span>
                </button>
                <button type="button" class="dropdown-item text-danger" data-modal-target="modal-sub-reject-<%= s.id %>">
                  <%- ip('close') %>
                  <span>Từ chối đơn</span>
                </button>
              </div>
            </details>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <div class="at-bar">
    <span class="small">Đã chọn <b data-bulk-count>0</b>/<%= rows.length %></span>
    <button class="btn btn-danger btn-sm" type="submit" name="action" value="reject" data-bulk-action data-bulk-confirm="Từ chối {n} đơn đã chọn?" disabled>Từ chối</button>
    <button class="btn btn-brand btn-sm" type="submit" name="action" value="approve" data-bulk-action data-bulk-confirm="Duyệt {n} đơn đã chọn với điểm đang nhập?" disabled>Duyệt đã chọn</button>
  </div>
</form>

<!-- MODALS CHO ĐƠN CHẤM TRÌNH -->
<% rows.forEach((s) => { %>
  <!-- Modal 1: Chi tiết đơn -->
  <div class="admin-modal" id="modal-sub-detail-<%= s.id %>" role="dialog" aria-modal="true" aria-labelledby="sub-title-<%= s.id %>">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <h3 id="sub-title-<%= s.id %>" style="margin: 0; font-size: 16px;">Chi tiết đơn: <%= s.full_name %></h3>
        <button type="button" class="btn btn-sm" data-modal-close aria-label="Đóng">✕</button>
      </div>
      <div class="admin-modal-body">
        <div class="stack" style="--gap: 12px;">
          <div class="sub-card" style="margin: 0;">
            <div class="row" style="--gap: 12px; align-items: center;">
              <%- include('../partials/avatar', { a: s, size: 48 }) %>
              <div>
                <strong><%= s.full_name %><% if (s.nickname) { %> (<%= s.nickname %>)<% } %></strong>
                <div class="small muted"><%= [fmt.GENDER_LABEL[s.gender], s.club, s.hometown].filter(Boolean).join(' · ') %></div>
              </div>
            </div>
            <div class="row small muted" style="--gap: 16px; margin-top: 10px; border-top: 1px dashed var(--border); padding-top: 8px;">
              <span>SĐT: <b class="tnum"><%= s.phone %></b></span>
              <span>Điểm tự chấm: <b class="tnum"><%= fmt.pts(s.points) %></b></span>
              <span>Thời gian: <b class="tnum"><%= fmt.dateTimeVN(s.created_at) %></b></span>
            </div>
          </div>
          <% if (s.description) { %>
            <div>
              <span class="tiny faint">Giới thiệu bản thân / kinh nghiệm:</span>
              <p class="small muted" style="white-space: pre-line; margin-top: 4px;"><%= s.description %></p>
            </div>
          <% } %>
        </div>
      </div>
      <div class="admin-modal-actions">
        <button type="button" class="btn btn-sm" data-modal-close>Đóng</button>
        <button type="button" class="btn btn-sm btn-brand" data-modal-close data-modal-target="modal-sub-approve-<%= s.id %>">Duyệt đơn này →</button>
      </div>
    </div>
  </div>

  <!-- Modal 2: Duyệt đơn -->
  <div class="admin-modal" id="modal-sub-approve-<%= s.id %>" role="dialog" aria-modal="true">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <h3 style="margin: 0; font-size: 16px;">Duyệt đơn chấm trình: <%= s.full_name %></h3>
        <button type="button" class="btn btn-sm" data-modal-close aria-label="Đóng">✕</button>
      </div>
      <form method="post" action="/admin/don-cham-trinh/<%= s.id %>/duyet">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <div class="admin-modal-body">
          <div class="stack" style="--gap: 10px;">
            <p>Xác nhận duyệt hồ sơ cho VĐV <strong><%= s.full_name %></strong> và thêm vào bảng xếp hạng?</p>
            <div class="field">
              <label for="approve-pts-<%= s.id %>">Điểm công nhận *</label>
              <input class="input tnum" id="approve-pts-<%= s.id %>" name="points" inputmode="decimal" required value="<%= fmt.pts(s.points) %>">
              <span class="hint">Điểm tự chấm: <%= fmt.pts(s.points) %>. Có thể chỉnh sửa điểm trước khi duyệt.</span>
            </div>
            <div class="field">
              <label for="approve-note-<%= s.id %>">Ghi chú quản trị (tùy chọn)</label>
              <input class="input" id="approve-note-<%= s.id %>" name="note" placeholder="Vd: Đã thẩm định video thi đấu...">
            </div>
          </div>
        </div>
        <div class="admin-modal-actions">
          <button type="button" class="btn btn-sm" data-modal-close>Hủy</button>
          <button type="submit" class="btn btn-sm btn-brand">Xác nhận duyệt</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal 3: Từ chối đơn -->
  <div class="admin-modal" id="modal-sub-reject-<%= s.id %>" role="dialog" aria-modal="true">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <h3 style="margin: 0; font-size: 16px;">Từ chối đơn: <%= s.full_name %></h3>
        <button type="button" class="btn btn-sm" data-modal-close aria-label="Đóng">✕</button>
      </div>
      <form method="post" action="/admin/don-cham-trinh/<%= s.id %>/tu-choi">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <div class="admin-modal-body">
          <p>Từ chối đơn chấm trình của <strong><%= s.full_name %></strong> (SĐT: <b class="tnum"><%= s.phone %></b>)?</p>
          <div class="field" style="margin-top: 10px;">
            <label for="sub-reject-note-<%= s.id %>">Lý do từ chối (tùy chọn)</label>
            <input class="input" id="sub-reject-note-<%= s.id %>" name="note" placeholder="Vd: Chưa đủ video minh chứng, số điện thoại không liên lạc được...">
          </div>
        </div>
        <div class="admin-modal-actions">
          <button type="button" class="btn btn-sm" data-modal-close>Hủy</button>
          <button type="submit" class="btn btn-sm btn-danger">Xác nhận từ chối</button>
        </div>
      </form>
    </div>
  </div>
<% }) %>
<% } else { %>
<div class="table-wrap">
  <table class="data atable">
    <thead><tr><th>Vận động viên</th><th class="num c-fit"><%= status === 'approved' ? 'Điểm' : 'Tự chấm' %></th><th class="c-act"><span class="sr-only">Xem</span></th></tr></thead>
    <tbody>
    <% rows.forEach((s) => { %>
      <tr class="at-row"<% if (s.athlete_id) { %> data-href="/admin/vdv/<%= s.athlete_id %>"<% } %>>
        <td class="c-main"><div class="at-who"><%- who(s, reviewed(s)) %></div></td>
        <td class="num c-fit tnum"><b><%= fmt.pts(s.points) %></b></td>
        <td class="c-act"><% if (s.athlete_id) { %><a class="at-btn" href="/admin/vdv/<%= s.athlete_id %>" title="Xem VĐV" aria-label="Xem VĐV <%= s.full_name %>"><%- ip('arrow') %></a><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('_bottom') %>
