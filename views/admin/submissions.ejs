<%- include('_top') %>
<nav class="tabs" aria-label="Trạng thái đơn">
  <% [['pending', 'Chờ duyệt'], ['approved', 'Đã duyệt'], ['rejected', 'Từ chối']].forEach(([k, l]) => { %><a class="tab" href="?status=<%= k %>" aria-current="<%= status === k %>"><%= l %> <span class="count">(<%= counts[k] || 0 %>)</span></a><% }) %>
</nav>
<% if (!rows.length) { %><div class="empty">Không có đơn nào.</div><% } %>
<div class="grid" style="--min: 320px;">
  <% rows.forEach((s) => { %>
  <div class="sub-card">
    <div class="row" style="--gap: 12px; flex-wrap: nowrap;">
      <span class="avatar" style="--s: 64px;"><% if (s.avatar) { %><img src="<%= s.avatar %>" alt=""><% } else { %><span><%= fmt.initials(s.full_name) %></span><% } %></span>
      <div style="min-width: 0;"><strong style="overflow-wrap: anywhere;"><%= s.full_name %></strong><% if (s.nickname) { %> <span class="muted small">(<%= s.nickname %>)</span><% } %><br><span class="small muted"><%= fmt.GENDER_LABEL[s.gender] %> · <%= s.club %> · <%= s.hometown %></span></div>
    </div>
    <div class="row small" style="--gap: 8px;"><span class="chip"><%= s.phone %></span><% if (s.phone_verified) { %><span class="chip chip-ok">Đã xác minh OTP</span><% } %><span class="chip">Tự chấm <%= fmt.pts(s.points) %></span></div>
    <% if (s.description) { %><p class="small muted" style="white-space: pre-line;"><%= s.description %></p><% } %>
    <span class="tiny faint">Gửi lúc <%= fmt.dateTimeVN(s.created_at) %><%= s.reviewed_by ? ` · ${fmt.SUB_STATUS_LABEL[s.status]} bởi ${s.reviewed_by}` : '' %><%= s.admin_note ? ` · ${s.admin_note}` : '' %></span>
    <% if (s.status === 'pending') { %>
    <form class="form" method="post" action="/admin/don-cham-trinh/<%= s.id %>/duyet" style="gap: 10px;">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="row" style="--gap: 8px; flex-wrap: nowrap;"><label class="sr-only" for="p<%= s.id %>">Điểm duyệt</label><input class="input tnum" id="p<%= s.id %>" name="points" inputmode="decimal" value="<%= fmt.pts(s.points) %>" style="flex: 1;"><button class="btn btn-brand" type="submit">Duyệt</button></div>
    </form>
    <form class="row" method="post" action="/admin/don-cham-trinh/<%= s.id %>/tu-choi" style="--gap: 8px; flex-wrap: nowrap;">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <label class="sr-only" for="n<%= s.id %>">Lý do từ chối</label><input class="input" id="n<%= s.id %>" name="note" placeholder="Lý do từ chối" style="flex: 1; min-height: 44px;"><button class="btn btn-danger btn-sm" type="submit">Từ chối</button>
    </form>
    <% } else if (s.athlete_id) { %><a class="link small" href="/admin/vdv/<%= s.athlete_id %>">Xem VĐV đã tạo →</a><% } %>
  </div>
  <% }) %>
</div>
<%- include('_bottom') %>
