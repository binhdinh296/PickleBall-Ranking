<%- include('_top') %>
<%
  const ip = (n) => include('../partials/icon', { name: n });
  const meta = (s) => [fmt.GENDER_LABEL[s.gender], s.club, s.hometown].filter(Boolean).join(' · ');
  const who = (s, extra = '') => `${include('../partials/avatar', { a: s, size: 36 })}<span class="at-name"><strong>${fmt.esc(s.full_name)}${s.nickname ? ` <small>(${fmt.esc(s.nickname)})</small>` : ''}</strong><span class="at-meta">${fmt.esc(meta(s))}</span>${extra ? `<span class="at-meta">${fmt.esc(extra)}</span>` : ''}</span>`;
  const reviewed = (s) => [`${fmt.SUB_STATUS_LABEL[s.status]}${s.reviewed_by ? ` bởi ${s.reviewed_by}` : ''}`, s.reviewed_at && fmt.dateTimeVN(s.reviewed_at), s.admin_note].filter(Boolean).join(' · ');
%>
<nav class="tabs" aria-label="Trạng thái đơn">
  <% [['pending', 'Chờ duyệt'], ['approved', 'Đã duyệt'], ['rejected', 'Từ chối']].forEach(([k, l]) => { %><a class="tab" href="?status=<%= k %>" aria-current="<%= status === k %>"><%= l %> <span class="count">(<%= counts[k] || 0 %>)</span></a><% }) %>
</nav>
<% if (!rows.length) { %><div class="empty">Không có đơn nào.</div><% } else if (status === 'pending') { %>
<p class="small muted">Sửa điểm nếu cần rồi bấm <b>✓</b> để duyệt từng đơn, hoặc tích chọn nhiều đơn và duyệt một lần. Bấm vào tên để xem SĐT, mô tả hoặc từ chối đơn.</p>
<form method="post" action="/admin/don-cham-trinh/hang-loat" data-bulk-form>
  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
  <%# Nút mặc định bị tắt: nhấn Enter trong ô điểm không vô tình gửi nút của dòng khác %>
  <button type="submit" disabled hidden aria-hidden="true" tabindex="-1"></button>
  <div class="table-wrap">
    <table class="data atable">
      <thead><tr>
        <th class="c-chk"><input type="checkbox" data-check-all aria-label="Chọn tất cả"></th>
        <th>Vận động viên</th>
        <th class="num c-fit hide-m">Tự chấm</th>
        <th class="num c-fit">Điểm</th>
        <th class="c-act"><span class="sr-only">Duyệt</span></th>
      </tr></thead>
      <tbody>
      <% rows.forEach((s) => { %>
        <tr class="at-row">
          <td class="c-chk"><input type="checkbox" name="ids" value="<%= s.id %>" data-check-item aria-label="Chọn <%= s.full_name %>"></td>
          <td class="c-main"><button type="button" class="at-who" data-row-toggle aria-expanded="false" aria-controls="d<%= s.id %>"><%- who(s) %></button></td>
          <td class="num c-fit c-sub tnum hide-m"><%= fmt.pts(s.points) %></td>
          <td class="num c-fit"><label class="sr-only" for="p<%= s.id %>">Điểm duyệt cho <%= s.full_name %></label><input class="input tnum at-pts" id="p<%= s.id %>" name="points_<%= s.id %>" inputmode="decimal" value="<%= fmt.pts(s.points) %>" data-self="<%= fmt.pts(s.points) %>" autocomplete="off"></td>
          <td class="c-act">
            <button class="at-btn ok" type="submit" formaction="/admin/don-cham-trinh/<%= s.id %>/duyet" title="Duyệt" aria-label="Duyệt <%= s.full_name %>"><%- ip('check') %></button><button class="at-btn no hide-m" type="submit" formaction="/admin/don-cham-trinh/<%= s.id %>/tu-choi" title="Từ chối" aria-label="Từ chối <%= s.full_name %>" data-confirm-one="Từ chối đơn của <%= s.full_name %>?"><%- ip('close') %></button>
          </td>
        </tr>
        <tr class="at-detail" id="d<%= s.id %>" hidden>
          <td colspan="5"><div class="at-detail-in">
            <div class="row small" style="--gap: 6px 8px;"><span class="chip tnum"><%= s.phone %></span><span class="chip">Tự chấm <%= fmt.pts(s.points) %></span><span class="tiny faint">Gửi lúc <%= fmt.dateTimeVN(s.created_at) %></span></div>
            <% if (s.description) { %><p class="small muted" style="white-space: pre-line; margin: 0;"><%= s.description %></p><% } %>
            <div class="row" style="--gap: 8px; flex-wrap: nowrap;"><label class="sr-only" for="n<%= s.id %>">Lý do từ chối</label><input class="input" id="n<%= s.id %>" name="note_<%= s.id %>" placeholder="Lý do (không bắt buộc)" maxlength="300" autocomplete="off" style="flex: 1; min-width: 0;"><button class="btn btn-danger btn-sm" type="submit" formaction="/admin/don-cham-trinh/<%= s.id %>/tu-choi" data-confirm-one="Từ chối đơn của <%= s.full_name %>?">Từ chối</button></div>
          </div></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <div class="at-bar">
    <span class="small">Đã chọn <b data-bulk-count>0</b>/<%= rows.length %></span>
    <button class="btn btn-danger btn-sm" type="submit" name="action" value="reject" data-bulk-action data-bulk-confirm="Từ chối {n} đơn đã chọn?" disabled>Từ chối</button>
    <button class="btn btn-brand btn-sm" type="submit" name="action" value="approve" data-bulk-action data-bulk-confirm="Duyệt {n} đơn đã chọn với điểm đang nhập?" disabled>Duyệt đã chọn</button>
  </div>
</form>
<% } else { %>
<div class="table-wrap">
  <table class="data atable">
    <thead><tr><th>Vận động viên</th><th class="num c-fit"><%= status === 'approved' ? 'Điểm' : 'Tự chấm' %></th><th class="c-act"><span class="sr-only">Xem</span></th></tr></thead>
    <tbody>
    <% rows.forEach((s) => { %>
      <tr class="at-row"<% if (s.athlete_id) { %> data-href="/admin/vdv/<%= s.athlete_id %>"<% } %>>
        <td class="c-main"><div class="at-who"><%- who(s, reviewed(s)) %></div></td>
        <td class="num c-fit tnum"><b><%= fmt.pts(s.points) %></b></td>
        <td class="c-act"><% if (s.athlete_id) { %><a class="at-btn" href="/admin/vdv/<%= s.athlete_id %>" title="Xem VĐV" aria-label="Xem VĐV <%= s.full_name %>"><%- ip('arrow') %></a><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('_bottom') %>
