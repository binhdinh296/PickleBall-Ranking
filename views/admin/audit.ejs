<%- include('_top') %>
<% if (!rows.length) { %><div class="empty">Chưa có nhật ký.</div><% } else { %>
<div class="table-wrap">
  <table class="data atable">
    <thead><tr><th class="c-fit">Thời gian</th><th class="c-fit hide-m">Người</th><th>Thao tác</th></tr></thead>
    <tbody>
      <% rows.forEach((r) => { %><tr class="at-row">
        <td class="c-fit c-sub tnum"><%= fmt.dateTimeVN(r.created_at) %><span class="at-meta show-m"><%= r.username || '—' %></span></td>
        <td class="c-fit c-sub hide-m"><%= r.username || '—' %></td>
        <td class="c-main"><span class="at-name"><strong><code><%= r.action %></code></strong><% if (r.target || r.detail) { %><span class="at-meta" title="<%= [r.target, r.detail].filter(Boolean).join(' · ') %>"><%= [r.target, r.detail].filter(Boolean).join(' · ') %></span><% } %></span></td>
      </tr><% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('_bottom') %>
