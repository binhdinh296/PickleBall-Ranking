<%- include('_top') %>

<div class="row" style="justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
  <p class="tiny faint at-count" style="margin: 0;"><%= rows.length %> đối tác & nhà tài trợ</p>
  <button type="button" class="btn btn-brand btn-sm" data-toggle-target="new-partner-details">
    <%- include('../partials/icon', { name: 'plus' }) %>Thêm đối tác mới
  </button>
</div>

<!-- Form thêm đối tác mới (gập mở) -->
<details class="card card-pad stack" id="new-partner-details" style="--gap: 12px; margin-bottom: 16px;" <%= !rows.length ? 'open' : '' %>>
  <summary class="section-title" style="cursor: pointer; user-select: none;">
    <span>+ Thêm đối tác mới</span>
  </summary>
  <form class="form" method="post" action="/admin/doi-tac" enctype="multipart/form-data" style="gap: 12px; margin-top: 8px;">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <div class="form-grid two">
      <div class="field">
        <label for="new_name">Tên đối tác / Nhà tài trợ *</label>
        <input class="input" id="new_name" name="name" placeholder="Ví dụ: Kamito, Wilson, Pickleball Việt Nam..." required maxlength="100">
      </div>
      <div class="field">
        <label for="new_url">Website / Fanpage</label>
        <input class="input" id="new_url" name="url" placeholder="https://..." maxlength="300">
      </div>
      <div class="field">
        <label for="new_logo">Logo đối tác (PNG, JPG, WebP)</label>
        <input class="input" id="new_logo" type="file" name="logo" accept="image/jpeg,image/png,image/webp">
        <span class="hint">Nên dùng file ảnh logo nền trong suốt (PNG), kích thước chuẩn 480x240 px.</span>
      </div>
      <div class="field">
        <label for="new_sort">Thứ tự hiển thị</label>
        <input class="input tnum" id="new_sort" name="sort_order" inputmode="numeric" value="0" placeholder="0">
        <span class="hint">Số nhỏ hơn sẽ đứng trước trên website.</span>
      </div>
    </div>
    <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <label class="check">
        <input type="checkbox" name="visible" value="1" checked>
        <span>Hiển thị trên trang chủ và chân trang</span>
      </label>
      <button class="btn btn-brand" type="submit">Lưu đối tác</button>
    </div>
  </form>
</details>

<% if (!rows.length) { %>
  <div class="empty">Chưa có đối tác nào. Bấm <strong>"+ Thêm đối tác mới"</strong> ở trên để thêm đối tác đầu tiên.</div>
<% } else { %>
<div class="table-wrap">
  <table class="data atable">
    <thead>
      <tr>
        <th class="c-fit" style="text-align: center;">Logo</th>
        <th>Đối tác & Website</th>
        <th class="c-fit num">Thứ tự</th>
        <th class="c-fit hide-m" style="text-align: center;">Trạng thái</th>
        <th class="c-act" style="text-align: right;">Thao tác</th>
      </tr>
    </thead>
    <tbody>
    <% rows.forEach((p) => { %>
      <tr class="at-row">
        <td class="c-fit" style="vertical-align: middle; text-align: center;">
          <div style="width: 76px; height: 38px; border-radius: 6px; border: 1px solid var(--line); background: #ffffff; display: inline-flex; align-items: center; justify-content: center; padding: 3px; overflow: hidden;">
            <% if (p.logo) { %>
              <img src="<%= p.logo %>" alt="<%= p.name %>" style="max-height: 100%; max-width: 100%; object-fit: contain;">
            <% } else { %>
              <span class="tiny faint" style="color: #666; font-weight: 600;">No logo</span>
            <% } %>
          </div>
        </td>

        <td class="c-main" style="vertical-align: middle;">
          <div class="stack" style="--gap: 2px;">
            <strong style="font-size: 14px;"><%= p.name %></strong>
            <% if (p.url) { %>
              <a href="<%= p.url %>" target="_blank" rel="noopener" class="small muted" style="display: inline-flex; align-items: center; gap: 4px; color: var(--accent, #f59e0b);">
                <span class="clip" style="max-width: 320px;"><%= p.url %></span>
                <%- include('../partials/icon', { name: 'external' }) %>
              </a>
            <% } else { %>
              <span class="tiny faint">Chưa gắn liên kết</span>
            <% } %>
            <span class="show-m" style="margin-top: 2px;">
              <span class="chip <%= p.visible ? 'chip-ok' : 'chip-muted' %>" style="font-size: 10px;"><%= p.visible ? 'Hiển thị' : 'Đang ẩn' %></span>
            </span>
          </div>
        </td>

        <td class="c-fit num tnum" style="vertical-align: middle;">
          <b><%= p.sort_order || 0 %></b>
        </td>

        <td class="c-fit hide-m" style="vertical-align: middle; text-align: center;">
          <span class="chip <%= p.visible ? 'chip-ok' : 'chip-muted' %>">
            <%= p.visible ? 'Hiển thị' : 'Đang ẩn' %>
          </span>
        </td>

        <!-- CỘT THAO TÁC: NÚT OPTION DROPDOWN DUY NHẤT -->
        <td class="c-act" style="vertical-align: middle; text-align: right;">
          <details class="action-dropdown">
            <summary class="btn btn-sm" aria-label="Thao tác cho <%= p.name %>">
              <span>Thao tác</span> <span style="font-size: 10px; opacity: 0.7;">▾</span>
            </summary>
            <div class="dropdown-pop">
              <button type="button" class="dropdown-item" data-modal-target="modal-edit-p-<%= p.id %>">
                <%- include('../partials/icon', { name: 'edit' }) %>
                <span>Sửa đối tác</span>
              </button>

              <div class="dropdown-divider"></div>

              <form method="post" action="/admin/doi-tac/<%= p.id %>/xoa" data-confirm="Xoá vĩnh viễn đối tác &quot;<%= p.name %>&quot;?">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-item danger">
                  <%- include('../partials/icon', { name: 'close' }) %>
                  <span>Xóa đối tác</span>
                </button>
              </form>
            </div>
          </details>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<!-- POPUP MODALS CHỈNH SỬA CHO TỪNG ĐỐI TÁC -->
<% rows.forEach((p) => { %>
<div class="admin-modal" id="modal-edit-p-<%= p.id %>" role="dialog" aria-modal="true" aria-labelledby="modal-title-p-<%= p.id %>">
  <div class="admin-modal-content">
    <div class="admin-modal-header">
      <h3 id="modal-title-p-<%= p.id %>">Sửa đối tác: <%= p.name %></h3>
      <button type="button" class="admin-modal-close-btn" data-modal-close aria-label="Đóng popup">✕</button>
    </div>
    <form class="form" method="post" action="/admin/doi-tac" enctype="multipart/form-data">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <input type="hidden" name="id" value="<%= p.id %>">
      <div class="admin-modal-body stack" style="--gap: 12px;">
        <div class="form-grid two">
          <div class="field">
            <label for="name_<%= p.id %>">Tên đối tác *</label>
            <input class="input" id="name_<%= p.id %>" name="name" required value="<%= p.name || '' %>" maxlength="100">
          </div>
          <div class="field">
            <label for="url_<%= p.id %>">Website / Fanpage</label>
            <input class="input" id="url_<%= p.id %>" name="url" value="<%= p.url || '' %>" placeholder="https://..." maxlength="300">
          </div>
          <div class="field">
            <label for="logo_<%= p.id %>">Thay Logo mới</label>
            <input class="input" id="logo_<%= p.id %>" type="file" name="logo" accept="image/jpeg,image/png,image/webp">
            <span class="hint">Để trống nếu muốn giữ nguyên logo hiện tại.</span>
          </div>
          <div class="field">
            <label for="sort_<%= p.id %>">Thứ tự hiển thị</label>
            <input class="input tnum" id="sort_<%= p.id %>" name="sort_order" inputmode="numeric" value="<%= p.sort_order || 0 %>">
          </div>
        </div>
        <label class="check" style="margin-top: 4px;">
          <input type="checkbox" name="visible" value="1" <%= p.visible !== false ? 'checked' : '' %>>
          <span>Hiển thị trên website</span>
        </label>
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="btn btn-sm" data-modal-close>Hủy</button>
        <button class="btn btn-brand btn-sm" type="submit">Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>
<% }) %>

<% } %>

<%- include('_bottom') %>