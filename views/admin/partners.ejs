<%- include('_top') %>
<div class="grid" style="--min: 320px; align-items: start;">
  <% rows.concat([{}]).forEach((p) => { %>
  <form class="sub-card form" method="post" action="/admin/doi-tac" enctype="multipart/form-data" style="gap: 10px;">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <% if (p.id) { %><input type="hidden" name="id" value="<%= p.id %>"><% } %>
    <div class="partner-edit-head">
      <span class="partner"><% if (p.logo) { %><img src="<%= p.logo %>" alt=""><% } else { %><%= p.id ? p.name : 'Đối tác mới' %><% } %></span>
      <div class="stack" style="--gap: 8px;"><input class="input" name="name" placeholder="Tên đối tác" aria-label="Tên đối tác" required value="<%= p.name || '' %>"><input class="input" name="url" placeholder="https://…" aria-label="Link" value="<%= p.url || '' %>"></div>
    </div>
    <div class="form-grid two"><input class="input" type="file" name="logo" accept="image/jpeg,image/png,image/webp" aria-label="Logo"><input class="input" name="sort_order" inputmode="numeric" value="<%= p.sort_order || 0 %>" aria-label="Thứ tự" placeholder="Thứ tự"></div>
    <label class="check"><input type="checkbox" name="visible" value="1" <%= p.visible !== false ? 'checked' : '' %>><span>Hiển thị</span></label>
    <div class="row" style="--gap: 8px;"><button class="btn btn-sm btn-brand" type="submit"><%= p.id ? 'Lưu' : 'Thêm đối tác' %></button></div>
  </form>
  <% }) %>
</div>
<% if (rows.length) { %>
<div class="row" style="--gap: 8px;">
  <% rows.forEach((p) => { %><form class="inline-form" method="post" action="/admin/doi-tac/<%= p.id %>/xoa" data-confirm="Xóa đối tác <%= p.name %>?"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-sm btn-danger" type="submit">Xóa <%= p.name %></button></form><% }) %>
</div>
<% } %>
<p class="tiny faint">Chỉ dùng logo khi đã được đối tác đồng ý.</p>
<%- include('_bottom') %>
