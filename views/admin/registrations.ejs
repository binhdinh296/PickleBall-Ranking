<%- include('_top', { back: `/admin/giai-dau/${d.event_id}` }) %>
<div class="toolbar" style="flex-wrap: wrap; gap: 8px;">
  <nav class="tabs grow" aria-label="Lọc trạng thái">
    <% [['', 'Tất cả'], ['new', 'Mới'], ['approved', 'Đã duyệt'], ['rejected', 'Từ chối']].forEach(([k, l]) => { %><a class="tab" href="?status=<%= k %>" aria-current="<%= status === k %>"><%= l %></a><% }) %>
  </nav>
  <a class="btn btn-sm" href="#them-dang-ky"><%- include('../partials/icon', { name: 'plus' }) %>Thêm đăng ký</a>
  <a class="btn btn-sm" href="/admin/noi-dung/<%= d.id %>/dang-ky.csv"><%- include('../partials/icon', { name: 'download' }) %>Xuất CSV</a>
  <a class="btn btn-brand btn-sm" href="/admin/noi-dung/<%= d.id %>/nhanh-dau"><%- include('../partials/icon', { name: 'trophy' }) %>Bốc thăm & Nhánh đấu →</a>
</div>
<% if (!regs.length) { %><div class="empty">Chưa có đăng ký nào trong danh sách này.</div><% } else {
  const ip = (n) => include('../partials/icon', { name: n });
  const tone = (st) => st === 'approved' ? 'chip-ok' : st === 'rejected' ? 'chip-err' : 'chip-warn';
  const total = (r) => r.points1 && (r.points2 || !r.name2) ? fmt.pts(r.points1 + (r.points2 || 0)) : '—';
%>
<div class="row" style="--gap: 6px; align-items: center; margin-bottom: 8px;">
  <p class="tiny faint at-count" style="margin: 0;"><%= regs.length %> <%= fmt.unitLabel(d) %> đăng ký</p>
  <span class="guide-tip" data-tip="Bấm Thao tác trên từng dòng để xem chi tiết, đổi trạng thái duyệt, sửa ghi chú nội bộ hoặc xóa đơn đăng ký.">?</span>
</div>
<form method="post" action="/admin/noi-dung/<%= d.id %>/dang-ky/hang-loat" data-bulk-form autocomplete="off">
  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
  <input type="hidden" name="back_status" value="<%= status %>">
  <button type="submit" disabled hidden aria-hidden="true" tabindex="-1"></button>
  <div class="table-wrap reg-scroll">
    <table class="data atable reg-table">
      <thead><tr>
        <th class="c-chk"><input type="checkbox" data-check-all aria-label="Chọn tất cả"></th>
        <th class="c-idx">#</th>
        <th><%= fmt.isSingle(d) ? "Vận động viên" : "Đôi" %> <span class="tiny faint reg-hint">· rê chuột / chạm vào tên để xem SĐT</span></th>
        <th class="num c-fit hide-m reg-pts"><%= fmt.isSingle(d) ? 'Trình' : 'Trình từng VĐV' %></th>
        <th class="num c-fit"><%= fmt.isSingle(d) ? 'Điểm' : 'Tổng' %></th>
        <th class="c-fit hide-m">Trạng thái</th>
        <th class="c-act" style="text-align: right;">Thao tác</th>
      </tr></thead>
      <tbody>
      <% regs.forEach((r, i) => { %>
        <tr class="at-row">
          <td class="c-chk"><input type="checkbox" name="ids" value="<%= r.id %>" data-check-item data-status="<%= r.status %>" aria-label="Chọn <%= fmt.regName(r) %>"></td>
          <td class="c-idx"><%= i + 1 %></td>
          <td class="c-main">
            <span class="reg-who" tabindex="0" data-hover-tip>
              <strong class="reg-name"><%= fmt.regName(r) %></strong><% if (r.admin_note) { %><span class="reg-note-dot" aria-label="Có ghi chú">✎</span><% } %>
              <template>
                <div class="ht-row"><b><%= r.name1 %></b><span>Trình <%= r.points1 ? fmt.pts(r.points1) : '?' %></span><span class="tnum"><%= r.phone1 || 'chưa có SĐT' %></span></div>
                <% if (r.name2) { %><div class="ht-row"><b><%= r.name2 %></b><span>Trình <%= r.points2 ? fmt.pts(r.points2) : '?' %></span><span class="tnum"><%= r.phone2 || 'chưa có SĐT' %></span></div><% } %>
                <div class="ht-meta">Đăng ký lúc <%= fmt.dateTimeVN(r.created_at) %></div>
                <% if (r.admin_note) { %><div class="ht-meta">Ghi chú: <%= r.admin_note %></div><% } %>
              </template>
            </span>
          </td>
          <td class="num c-fit tnum hide-m reg-pts"><%= r.points1 ? fmt.pts(r.points1) : '?' %><% if (r.name2) { %> + <%= r.points2 ? fmt.pts(r.points2) : '?' %><% } %></td>
          <td class="num c-fit tnum"><b><%= total(r) %></b></td>
          <td class="c-fit hide-m"><span class="chip <%= tone(r.status) %>"><%= fmt.REG_STATUS_LABEL[r.status] %></span></td>
          <td class="c-act" style="text-align: right; vertical-align: middle;">
            <details class="action-dropdown">
              <summary class="btn btn-sm" aria-label="Thao tác cho <%= fmt.regName(r) %>">
                <span>Thao tác</span> <span style="font-size: 10px; opacity: 0.7;">▾</span>
              </summary>
              <div class="dropdown-pop">
                <button type="button" class="dropdown-item" data-modal-target="modal-reg-<%= r.id %>">
                  <%- ip('edit') %>
                  <span>Chi tiết &amp; Ghi chú</span>
                </button>
                <div class="dropdown-divider"></div>
                <% if (r.status !== 'approved') { %>
                  <button type="button" class="dropdown-item text-ok" data-modal-target="modal-reg-approve-<%= r.id %>">
                    <%- ip('check') %>
                    <span>Duyệt đơn</span>
                  </button>
                <% } %>
                <% if (r.status !== 'rejected') { %>
                  <button type="button" class="dropdown-item text-danger" data-modal-target="modal-reg-reject-<%= r.id %>">
                    <%- ip('close') %>
                    <span>Từ chối</span>
                  </button>
                <% } %>
                <% if (r.status !== 'new') { %>
                  <button type="button" class="dropdown-item" data-modal-target="modal-reg-reset-<%= r.id %>">
                    <%- ip('refresh') %>
                    <span>Về Mới</span>
                  </button>
                <% } %>
                <div class="dropdown-divider"></div>
                <button type="button" class="dropdown-item text-danger" data-modal-target="modal-reg-delete-<%= r.id %>">
                  <%- ip('trash') %>
                  <span>Xóa đăng ký</span>
                </button>
              </div>
            </details>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <div class="at-bar">
    <span class="small">Đã chọn <b data-bulk-count>0</b>/<%= regs.length %></span>
    <button class="btn btn-danger btn-sm" type="submit" name="action" value="reject" data-bulk-action data-bulk-skip="rejected" data-bulk-confirm="Từ chối {n} <%= fmt.unitLabel(d) %> đã chọn?" disabled>Từ chối</button>
    <button class="btn btn-brand btn-sm" type="submit" name="action" value="approve" data-bulk-action data-bulk-skip="approved" data-bulk-confirm="Duyệt {n} <%= fmt.unitLabel(d) %> đã chọn?" disabled>Duyệt đã chọn</button>
  </div>
</form>

<!-- MODALS CHO CÁC THAO TÁC ĐĂNG KÝ -->
<% regs.forEach((r, i) => { %>
  <!-- Modal 1: Chi tiết & Ghi chú -->
  <div class="admin-modal" id="modal-reg-<%= r.id %>" role="dialog" aria-modal="true" aria-labelledby="reg-title-<%= r.id %>">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <h3 id="reg-title-<%= r.id %>" style="margin: 0; font-size: 16px;">Chi tiết đăng ký #<%= i + 1 %>: <%= fmt.regName(r) %></h3>
        <button type="button" class="btn btn-sm" data-modal-close aria-label="Đóng">✕</button>
      </div>
      <div class="admin-modal-body">
        <div class="stack" style="--gap: 12px;">
          <div class="sub-card" style="margin: 0;">
            <div class="form-grid two">
              <div>
                <span class="tiny faint">VĐV 1:</span>
                <div><strong><%= r.name1 %></strong> (<%= r.points1 ? fmt.pts(r.points1) : '?' %>)</div>
                <div class="small muted tnum"><%= r.phone1 || 'Chưa có SĐT' %></div>
              </div>
              <% if (r.name2) { %><div>
                <span class="tiny faint">VĐV 2:</span>
                <div><strong><%= r.name2 %></strong> (<%= r.points2 ? fmt.pts(r.points2) : '?' %>)</div>
                <div class="small muted tnum"><%= r.phone2 || 'Chưa có SĐT' %></div>
              </div><% } %>
            </div>
            <div class="row small muted" style="--gap: 16px; margin-top: 8px; border-top: 1px dashed var(--border); padding-top: 6px;">
              <span>Tổng điểm: <b class="tnum"><%= total(r) %></b></span>
              <span>Trạng thái: <span class="chip <%= tone(r.status) %>"><%= fmt.REG_STATUS_LABEL[r.status] %></span></span>
              <span>Ngày gửi: <b class="tnum"><%= fmt.dateTimeVN(r.created_at) %></b></span>
            </div>
          </div>

          <form method="post" action="/admin/dang-ky/<%= r.id %>/trang-thai">
            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
            <div class="stack" style="--gap: 10px;">
              <div class="field">
                <label for="status-<%= r.id %>">Cập nhật trạng thái</label>
                <select class="input" id="status-<%= r.id %>" name="status">
                  <option value="new" <%= r.status === 'new' ? 'selected' : '' %>>Mới (Chờ duyệt)</option>
                  <option value="approved" <%= r.status === 'approved' ? 'selected' : '' %>>Đã duyệt</option>
                  <option value="rejected" <%= r.status === 'rejected' ? 'selected' : '' %>>Từ chối</option>
                </select>
              </div>
              <div class="field">
                <label for="note-<%= r.id %>">Ghi chú quản trị</label>
                <textarea class="input" id="note-<%= r.id %>" name="note" rows="2" placeholder="Ghi chú nội bộ, vd: đã nộp lệ phí, check CCCD..."><%= r.admin_note || '' %></textarea>
              </div>
              <div class="admin-modal-actions">
                <button type="button" class="btn btn-sm" data-modal-close>Đóng</button>
                <button type="submit" class="btn btn-sm btn-brand">Lưu thay đổi</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal 2: Duyệt đơn -->
  <% if (r.status !== 'approved') { %>
  <div class="admin-modal" id="modal-reg-approve-<%= r.id %>" role="dialog" aria-modal="true">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <h3 style="margin: 0; font-size: 16px;">Duyệt đăng ký</h3>
        <button type="button" class="btn btn-sm" data-modal-close aria-label="Đóng">✕</button>
      </div>
      <div class="admin-modal-body">
        <p>Xác nhận duyệt cho: <strong><%= fmt.regName(r) %></strong> (Tổng điểm: <b class="tnum"><%= total(r) %></b>)?</p>
      </div>
      <div class="admin-modal-actions">
        <button type="button" class="btn btn-sm" data-modal-close>Hủy</button>
        <form method="post" action="/admin/dang-ky/<%= r.id %>/trang-thai" style="margin: 0;">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <input type="hidden" name="status" value="approved">
          <button type="submit" class="btn btn-sm btn-brand">Xác nhận duyệt</button>
        </form>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Modal 3: Từ chối đơn -->
  <% if (r.status !== 'rejected') { %>
  <div class="admin-modal" id="modal-reg-reject-<%= r.id %>" role="dialog" aria-modal="true">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <h3 style="margin: 0; font-size: 16px;">Từ chối đăng ký</h3>
        <button type="button" class="btn btn-sm" data-modal-close aria-label="Đóng">✕</button>
      </div>
      <form method="post" action="/admin/dang-ky/<%= r.id %>/trang-thai">
        <div class="admin-modal-body">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <input type="hidden" name="status" value="rejected">
          <p>Từ chối đăng ký của <strong><%= fmt.regName(r) %></strong>?</p>
          <div class="field" style="margin-top: 10px;">
            <label for="reject-note-<%= r.id %>">Lý do từ chối (tùy chọn)</label>
            <input class="input" id="reject-note-<%= r.id %>" name="note" placeholder="Vd: Vượt quá giới hạn điểm, chưa đóng lệ phí..." value="<%= r.admin_note || '' %>">
          </div>
        </div>
        <div class="admin-modal-actions">
          <button type="button" class="btn btn-sm" data-modal-close>Hủy</button>
          <button type="submit" class="btn btn-sm btn-danger">Xác nhận từ chối</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <!-- Modal 4: Về Mới -->
  <% if (r.status !== 'new') { %>
  <div class="admin-modal" id="modal-reg-reset-<%= r.id %>" role="dialog" aria-modal="true">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <h3 style="margin: 0; font-size: 16px;">Chuyển về trạng thái Mới</h3>
        <button type="button" class="btn btn-sm" data-modal-close aria-label="Đóng">✕</button>
      </div>
      <div class="admin-modal-body">
        <p>Chuyển đơn của <strong><%= fmt.regName(r) %></strong> về trạng thái Mới (Chờ duyệt)?</p>
      </div>
      <div class="admin-modal-actions">
        <button type="button" class="btn btn-sm" data-modal-close>Hủy</button>
        <form method="post" action="/admin/dang-ky/<%= r.id %>/trang-thai" style="margin: 0;">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <input type="hidden" name="status" value="new">
          <button type="submit" class="btn btn-sm btn-brand">Chuyển về Mới</button>
        </form>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Modal 5: Xóa đăng ký -->
  <div class="admin-modal" id="modal-reg-delete-<%= r.id %>" role="dialog" aria-modal="true">
    <div class="admin-modal-card">
      <div class="admin-modal-header">
        <h3 style="margin: 0; font-size: 16px;">Xóa đơn đăng ký</h3>
        <button type="button" class="btn btn-sm" data-modal-close aria-label="Đóng">✕</button>
      </div>
      <div class="admin-modal-body">
        <p>Xác nhận xóa vĩnh viễn đơn đăng ký của <strong><%= fmt.regName(r) %></strong>?</p>
        <p class="small text-danger">Thao tác này không thể hoàn tác.</p>
      </div>
      <div class="admin-modal-actions">
        <button type="button" class="btn btn-sm" data-modal-close>Hủy</button>
        <form method="post" action="/admin/dang-ky/<%= r.id %>/xoa" style="margin: 0;">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-danger">Xóa vĩnh viễn</button>
        </form>
      </div>
    </div>
  </div>
<% }) %>
<% } %>
<link rel="stylesheet" href="/static/css/hover-tip.css?v=<%= locals.assetV || '' %>">
<script src="/static/js/hover-tip.js?v=<%= locals.assetV || '' %>" defer></script>
<%- include('_reg-quick-add') %>
<%- include('_bottom') %>
