<%- include('_top', { back: `/admin/giai-dau/${ev.id}` }) %>

<div class="stack" style="--gap: 16px; max-width: 860px;">
  <p class="muted small" style="margin: 0;">Giải: <strong><%= ev.name %></strong></p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <form class="card card-pad form" method="post" action="<%= d.id ? `/admin/noi-dung/${d.id}/sua` : `/admin/giai-dau/${ev.id}/noi-dung/moi` %>" enctype="multipart/form-data" data-once>
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

    <!-- THANH TABS CHUYỂN ĐỔI NỘI DUNG -->
    <nav class="admin-tabs" role="tablist" aria-label="Nhóm nội dung">
      <button type="button" class="admin-tab active" role="tab" aria-selected="true" data-tab-target="step-1">
        <%- include('../partials/icon', { name: 'trophy' }) %>
        <span>Thông tin &amp; Thể thức</span>
      </button>
      <button type="button" class="admin-tab" role="tab" aria-selected="false" data-tab-target="step-2">
        <%- include('../partials/icon', { name: 'users' }) %>
        <span>Tiêu chuẩn trình độ</span>
      </button>
      <button type="button" class="admin-tab" role="tab" aria-selected="false" data-tab-target="step-3">
        <%- include('../partials/icon', { name: 'trophy' }) %>
        <span>Cơ cấu giải thưởng</span>
      </button>
    </nav>

    <!-- TAB 1: THÔNG TIN CƠ BẢN & THỂ THỨC -->
    <div class="admin-tab-pane" id="step-1">
      <div class="form-grid two">
        <div class="field">
          <label for="name">Tên nội dung thi đấu *</label>
          <input class="input" id="name" name="name" required maxlength="100" value="<%= d.name || '' %>" placeholder="Đôi nam phong trào 6.5">
        </div>
        <div class="field">
          <label for="subtitle">Dòng phụ mô tả</label>
          <input class="input" id="subtitle" name="subtitle" maxlength="100" value="<%= d.subtitle || '' %>" placeholder="Max 16 đôi · Tổng trình ≤ 6.500">
        </div>
        <div class="field">
          <label for="format">Thể thức thi đấu</label>
          <select class="input" id="format" name="format">
            <option value="roundrobin" <%= d.format === 'roundrobin' ? 'selected' : '' %>>Chia Bảng</option>
            <option value="knockout" <%= d.format !== 'roundrobin' ? 'selected' : '' %>>Loại Trực Tiếp thua đi Playoff</option>
          </select>
        </div>
        <div class="field">
          <label for="category">Thể loại *</label>
          <select class="input" id="category" name="category" required>
            <% const curCat = fmt.categoryFromDivision(d); %>
            <% Object.entries(fmt.CATEGORIES).forEach(([k, c]) => { %>
              <option value="<%= k %>" <%= (curCat === k || (!d.id && k === fmt.DEFAULT_CATEGORY)) ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
          <span class="hint">Tự động cấu hình thể thức Đơn / Đôi và quy định giới tính VĐV.</span>
        </div>
        <div class="field">
          <label for="max_teams">Số đôi / VĐV tối đa</label>
          <input class="input" id="max_teams" name="max_teams" inputmode="numeric" value="<%= d.max_teams || '' %>" placeholder="vd: 16">
        </div>
        <div class="field">
          <label for="banner">Ảnh banner nội dung</label>
          <input class="input" id="banner" name="banner" type="file" accept="image/jpeg,image/png,image/webp">
          <% if (d.banner) { %>
            <div style="margin-top: 6px;">
              <img src="<%= d.banner %>" alt="" style="max-height: 70px; border-radius: var(--r-sm); border: 1px solid var(--line);">
            </div>
          <% } %>
        </div>
        <div class="field">
          <label for="sort_order">Thứ tự hiển thị</label>
          <input class="input" id="sort_order" name="sort_order" inputmode="numeric" value="<%= d.sort_order || 0 %>">
        </div>
      </div>
    </div>

    <!-- TAB 2: TIÊU CHUẨN TRÌNH ĐỘ & TIẾP SỨC -->
    <div class="admin-tab-pane" id="step-2" hidden>
      <div class="form-grid two">
        <div class="field">
          <label for="max_total_points">
            Tổng trình tối đa (2 VĐV)
            <span class="guide-tip" data-tip="Tổng điểm trình của 2 VĐV cộng lại không vượt quá mức này. Có thể nhập số thập phân vd: 5.5, 6.0, 6.5...">?</span>
          </label>
          <input class="input tnum" id="max_total_points" name="max_total_points" inputmode="decimal" value="<%= d.max_total_points ? fmt.pts(d.max_total_points) : '' %>" placeholder="Không giới hạn, vd: 6.500">
        </div>
        <div class="field">
          <label for="min_player_points">
            Trình tối thiểu mỗi VĐV
            <span class="guide-tip" data-tip="Điểm sàn tối thiểu cho từng cá nhân VĐV tham gia nội dung này.">?</span>
          </label>
          <input class="input tnum" id="min_player_points" name="min_player_points" inputmode="decimal" value="<%= d.min_player_points ? fmt.pts(d.min_player_points) : '' %>" placeholder="Không giới hạn, vd: 2.500">
        </div>
        <div class="field">
          <label for="max_player_points">
            Trình tối đa mỗi VĐV
            <span class="guide-tip" data-tip="Điểm trần tối đa cho từng cá nhân VĐV, tránh chênh lệch trình độ quá lớn.">?</span>
          </label>
          <input class="input tnum" id="max_player_points" name="max_player_points" inputmode="decimal" value="<%= d.max_player_points ? fmt.pts(d.max_player_points) : '' %>" placeholder="Không giới hạn, vd: 3.500">
        </div>
        <div class="field">
          <label for="relay_legs">
            Số chặng tiếp sức (Relay)
            <span class="guide-tip" data-tip="Dành cho nội dung đồng đội tiếp sức (vd: 5 chặng chạm 55 điểm). Để 0 nếu là thi đấu cặp đôi thông thường.">?</span>
          </label>
          <input class="input" id="relay_legs" name="relay_legs" inputmode="numeric" value="<%= d.relay_legs || 0 %>">
        </div>
        <div class="field">
          <label for="relay_step">
            Điểm mỗi chặng tiếp sức
            <span class="guide-tip" data-tip="Ví dụ 11 điểm/chặng → các mốc lần lượt là 11 - 22 - 33 - 44 - 55.">?</span>
          </label>
          <input class="input" id="relay_step" name="relay_step" inputmode="numeric" value="<%= d.relay_step || 11 %>">
        </div>
      </div>
    </div>

    <!-- TAB 3: CƠ CẤU GIẢI THƯỞNG -->
    <div class="admin-tab-pane" id="step-3" hidden>
      <div class="stack" style="--gap: 12px;" data-prizes>
        <div class="row" style="justify-content: space-between; align-items: center;">
          <span class="label" style="font-size: 14px; font-weight: 700;">Danh sách giải thưởng &amp; cúp</span>
          <span class="guide-tip" data-tip="Giá trị nhập số tiền VNĐ sẽ tự định dạng, hoặc nhập chữ (ví dụ: 'Cúp Vàng + 20.000.000đ').">?</span>
        </div>

        <div class="stack" style="--gap: 8px;" data-prize-rows>
          <% (d.prizes || []).forEach((p) => { %>
            <div class="prize-edit">
              <input class="input" name="prize_label" value="<%= p.label %>" aria-label="Hạng" placeholder="Vô địch">
              <input class="input" name="prize_amount" value="<%= p.amount %>" aria-label="Giá trị" placeholder="15.000.000đ + Cúp">
              <button class="btn" type="button" data-prize-remove aria-label="Bỏ dòng">✕</button>
            </div>
          <% }) %>
        </div>

        <template>
          <div class="prize-edit">
            <input class="input" name="prize_label" aria-label="Hạng" placeholder="Giải thưởng">
            <input class="input" name="prize_amount" aria-label="Giá trị" placeholder="5.000.000đ">
            <button class="btn" type="button" data-prize-remove aria-label="Bỏ dòng">✕</button>
          </div>
        </template>

        <button class="btn btn-sm" type="button" data-prize-add style="align-self: flex-start;">
          <%- include('../partials/icon', { name: 'plus' }) %>Thêm hạng giải thưởng
        </button>
      </div>
    </div>

    <div class="form-actions" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--line); display: flex; justify-content: flex-end;">
      <button class="btn btn-brand btn-lg" type="submit">
        <%- include('../partials/icon', { name: 'check' }) %>
        <%= d.id ? 'Lưu thay đổi nội dung' : 'Hoàn tất & Tạo nội dung' %>
      </button>
    </div>
  </form>

  <% if (d.id) { %>
    <div class="row" style="justify-content: flex-end; margin-top: 8px;">
      <form method="post" action="/admin/noi-dung/<%= d.id %>/xoa" data-confirm="Xóa nội dung này cùng đăng ký, nhánh đấu và vinh danh?">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <button class="btn btn-danger btn-sm" type="submit">Xóa nội dung này</button>
      </form>
    </div>
  <% } %>
</div>

<%- include('_bottom') %>
