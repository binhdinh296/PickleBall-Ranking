<%- include('_top', { back: `/admin/giai-dau/${d.event_id}` }) %>
<% const streamsMap = Object.fromEntries(streams.map((s) => [s.id, s])); const ev = { slug: d.event.slug }; %>
<%- include('_division-nav', { tab: 'nhanh-dau' }) %>

<%- include('_bracket-setup') %>
<script src="/static/js/bracket-setup.js?v=<%= locals.assetV || '' %>" defer></script>

<link rel="stylesheet" href="/static/css/standings-admin.css?v=<%= locals.assetV || '' %>">
<% if (locals.groupTables && Object.keys(groupTables).length) {
  const gList = Object.values(groupTables);
  const doneGroups = gList.filter((g) => g.complete).length;
  // Số suất đi tiếp mỗi bảng: nhánh sau có ô "Nhì Bảng …" thì lấy 2, không thì chỉ Nhất
  const advance = matches.some((m) => !m.zone && [m.label_a, m.label_b].some((l) => /^Nhì Bảng /.test(l || ''))) ? 2 : 1;
%>
<div class="card card-pad stack" style="--gap: 16px; margin: 12px 0 16px;">
  <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
    <div>
      <h2 class="section-title" style="margin: 0;">Bảng xếp hạng các bảng đấu</h2>
      <span class="tiny faint">Tiêu chí: 1. Thắng ➔ 2. Hiệu số ➔ 3. Đối đầu · Nhất/Nhì chỉ xác định khi bảng đã đấu xong · <%= doneGroups %>/<%= gList.length %> bảng đã xong</span>
    </div>
    <form method="post" action="/admin/noi-dung/<%= d.id %>/dong-bo-bang">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <button class="btn btn-brand btn-sm" type="submit"<%= doneGroups ? '' : ' disabled title="Chưa có bảng nào đấu xong"' %>><%- include('../partials/icon', { name: 'trophy' }) %>Đưa Nhất/Nhì các bảng đã xong vào nhánh sau</button>
    </form>
  </div>
  <div class="grid" style="--min: 320px; gap: 14px;">
    <% Object.entries(groupTables).forEach(([zName, gTable]) => { %><%- include('_standings', { st: gTable, title: zName, teamMap, advance }) %><% }) %>
  </div>
</div>
<% } %>

<% if (table) { %>
<div style="margin: 12px 0 16px;"><%- include('_standings', { st: table, title: 'Bảng xếp hạng vòng tròn', teamMap, advance: 0 }) %></div>
<% } %>

<!-- TIÊU ĐỀ SƠ ĐỒ THI ĐẤU & THANH CÔNG CỤ -->
<div class="row" style="justify-content: space-between; align-items: center; margin: 12px 0 8px; flex-wrap: wrap; gap: 8px;">
  <div class="row" style="--gap: 8px; align-items: center;">
    <h2 class="section-title" style="margin: 0;">Sơ đồ thi đấu (<%= matches.length %> trận)</h2>
    <% if (matches.length) { %><button type="button" class="btn btn-sm" data-bs-open="tab-draw">↻ Tạo lại nhánh đấu</button><% } %>
    <span class="guide-tip" data-tip="Bấm trực tiếp vào từng ô trận để nhập tỉ số, đổi nguồn đội, đổi sân đấu hoặc phát livestream.">?</span>
  </div>
  <% if (matches.length) { %>
    <details class="action-dropdown">
      <summary class="btn btn-sm">
        <span>+ Thêm trận thủ công</span> <span style="font-size: 10px; opacity: 0.7;">▾</span>
      </summary>
      <div class="dropdown-pop" style="min-width: 280px; padding: 12px;">
        <form class="form" method="post" action="/admin/noi-dung/<%= d.id %>/tran" style="gap: 8px;">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <div class="form-grid two" style="gap: 6px;">
            <div class="field"><label for="nm-round">Cột vòng</label><input class="input" id="nm-round" name="round_order" inputmode="numeric" placeholder="1, 2, 3…" required></div>
            <div class="field"><label for="nm-rname">Tên vòng</label><input class="input" id="nm-rname" name="round_name" placeholder="Playoff, Tứ kết…" list="round-names"></div>
            <div class="field"><label for="nm-code">Mã trận</label><input class="input" id="nm-code" name="code" placeholder="PO1, TK1…"></div>
            <div class="field"><label for="nm-zone">Khu riêng</label><input class="input" id="nm-zone" name="zone" placeholder="Bảng A / MINI"></div>
            <div class="field"><label for="nm-court">Sân</label><input class="input" id="nm-court" name="court" placeholder="Sân 1"></div>
            <div class="field"><label for="nm-time">Giờ</label><input class="input tnum" id="nm-time" name="start_time" placeholder="10:00"></div>
          </div>
          <% ['a', 'b'].forEach((s) => { %><%- include('../partials/slot-source', { s, m: {}, matches, teams }) %><% }) %>
          <datalist id="round-names"><% ['Vòng 1', 'Playoff', 'Vòng 2', 'Tứ kết', 'Bán kết', 'Chung kết'].forEach((n) => { %><option value="<%= n %>"><% }) %></datalist>
          <button class="btn btn-brand btn-sm" type="submit" style="margin-top: 4px;">Thêm trận vào sơ đồ</button>
        </form>
      </div>
    </details>
  <% } %>
</div>

<% if (!matches.length) { %><div class="empty">Chưa có trận nào.</div><% } else { %>
<%- include('../partials/bracket-board', { board, teamMap, teamNo, streams: streamsMap, d, ev, hrefFor: (m) => `/admin/tran/${m.id}` }) %>
<% } %>
<% if (matches.length) { %>
<!-- Popup nhập tỉ số nhanh (dùng chung): bấm thẻ trận trên sơ đồ để mở; Ctrl/⌘ + bấm để mở trang trận đầy đủ -->
<div class="admin-modal" id="modal-quick-score" role="dialog" aria-modal="true" aria-labelledby="qs-title">
  <div class="admin-modal-card qs-card">
    <div class="admin-modal-header">
      <h3 id="qs-title" style="margin: 0; font-size: 16px;"><span data-qs-code></span> <small class="muted" data-qs-round></small></h3>
      <button type="button" class="btn btn-sm" data-modal-close aria-label="Đóng">✕</button>
    </div>
    <form class="admin-modal-body qs-body" data-qs-form>
      <p class="alert alert-warning qs-wait" data-qs-wait hidden>Trận chưa đủ 2 đội (chờ kết quả trận trước), chỉ đặt được sân và giờ.</p>
      <% ['a', 'b'].forEach((s) => { %>
      <div class="qs-side" data-qs-side="<%= s %>">
        <span class="qs-name" data-qs-name="<%= s %>"></span>
        <div class="qs-ctl">
          <button type="button" class="btn" data-qs-step="-1" data-qs-for="<%= s %>" aria-label="Trừ 1 điểm">−</button>
          <input class="input tnum" name="score_<%= s %>" inputmode="numeric" autocomplete="off" aria-label="Điểm">
          <button type="button" class="btn btn-brand" data-qs-step="1" data-qs-for="<%= s %>" aria-label="Cộng 1 điểm">+</button>
        </div>
      </div>
      <% }) %>
      <div class="segmented qs-status" style="--n: 3;" role="radiogroup" aria-label="Trạng thái trận">
        <label><input type="radio" name="status" value="scheduled"><span>Chưa đấu</span></label>
        <label><input type="radio" name="status" value="live"><span>Đang đấu</span></label>
        <label><input type="radio" name="status" value="done"><span>Kết thúc</span></label>
      </div>
      <div class="form-grid two">
        <div class="field"><label for="qs-court">Sân</label><input class="input" id="qs-court" name="court" maxlength="30" placeholder="Sân 1" list="qs-courts"></div>
        <div class="field"><label for="qs-time">Giờ</label><input class="input tnum" id="qs-time" name="start_time" placeholder="10:00" maxlength="5"></div>
      </div>
      <datalist id="qs-courts"><% [...new Set(matches.map((x) => x.court).filter(Boolean))].sort().forEach((c) => { %><option value="<%= c %>"><% }) %></datalist>
      <p class="small text-danger qs-err" data-qs-err hidden></p>
    </form>
    <div class="admin-modal-actions qs-actions">
      <a class="btn btn-sm" href="#" data-qs-full>Mở trang trận đầy đủ</a>
      <span style="flex: 1;"></span>
      <button type="button" class="btn btn-sm" data-modal-close>Huỷ</button>
      <button type="button" class="btn btn-sm btn-brand" data-qs-save>Lưu</button>
    </div>
  </div>
</div>
<link rel="stylesheet" href="/static/css/quick-score.css?v=<%= locals.assetV || '' %>">
<script src="/static/js/quick-score.js?v=<%= locals.assetV || '' %>" defer></script>
<% } %>
<%- include('_bottom') %>
