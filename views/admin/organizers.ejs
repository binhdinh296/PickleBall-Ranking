<%- include('_top') %>
<%
  const expired = (o) => o.expires_at && new Date(o.expires_at) < new Date();
  const dateInput = (v) => v ? new Date(new Date(v).getTime() + 7 * 3600e3).toISOString().slice(0, 10) : '';
%>

<div class="row" style="justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
  <div class="row" style="--gap: 6px; align-items: center;">
    <p class="tiny faint at-count" style="margin: 0;"><%= rows.length %> đơn vị tổ chức</p>
    <span class="guide-tip" data-tip="Quy chế phân quyền: Mỗi đơn vị có Link đăng ký VĐV (<%= origin %>/mã/dangky) và Link quản trị giải riêng cho BTC. Giải tạo xong ở trạng thái Chờ duyệt cho đến khi duyệt công khai.">?</span>
  </div>
  <button type="button" class="btn btn-brand btn-sm" data-modal-target="modal-new-org">
    <%- include('../partials/icon', { name: 'plus' }) %>Tạo Ban tổ chức mới
  </button>
</div>

<!-- POPUP MODAL TẠO BAN TỔ CHỨC MỚI -->
<div class="admin-modal <%= locals.error ? 'open' : '' %>" id="modal-new-org" role="dialog" aria-modal="true" aria-labelledby="modal-title-new-org">
  <div class="admin-modal-content">
    <div class="admin-modal-header">
      <h3 id="modal-title-new-org">+ Thêm đơn vị Ban tổ chức mới &amp; Cấp link quản trị</h3>
      <button type="button" class="admin-modal-close-btn" data-modal-close aria-label="Đóng popup">✕</button>
    </div>
    <form class="form" method="post" action="/admin/ban-to-chuc">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="admin-modal-body stack" style="--gap: 12px;">
        <% if (locals.error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <div class="form-grid two">
          <div class="field">
            <label for="name">Tên đơn vị tổ chức *</label>
            <input class="input" id="name" name="name" required maxlength="150" placeholder="CLB Pickleball Hà Nội, Vitar Open..." value="<%= values.name || '' %>">
          </div>
          <div class="field">
            <label for="code">Mã giải (dùng cho link đăng ký) *</label>
            <input class="input" id="code" name="code" required maxlength="40" placeholder="vd: hanoipickleball" value="<%= values.code || '' %>">
            <span class="hint">Link đăng ký cho VĐV: <%= origin %>/<strong>mã</strong>/dangky</span>
          </div>
          <div class="field">
            <label for="contact_name">Người liên hệ</label>
            <input class="input" id="contact_name" name="contact_name" maxlength="100" placeholder="Họ tên người phụ trách" value="<%= values.contact_name || '' %>">
          </div>
          <div class="field">
            <label for="phone">Số điện thoại liên hệ</label>
            <input class="input" id="phone" name="phone" inputmode="tel" placeholder="09xxxxxxxx" value="<%= values.phone || '' %>">
          </div>
          <div class="field">
            <label for="expires_at">Hạn dùng link quản trị</label>
            <input class="input" type="date" id="expires_at" name="expires_at" value="<%= values.expires_at || '' %>">
            <span class="hint">Để trống: Không giới hạn thời hạn.</span>
          </div>
          <div class="field">
            <label for="note">Ghi chú nội bộ</label>
            <input class="input" id="note" name="note" maxlength="1000" placeholder="Ghi chú về BTC hoặc hợp đồng tài trợ..." value="<%= values.note || '' %>">
          </div>
        </div>
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="btn btn-sm" data-modal-close>Hủy</button>
        <button class="btn btn-brand btn-sm" type="submit">
          <%- include('../partials/icon', { name: 'plus' }) %>Tạo đơn vị và cấp 2 link
        </button>
      </div>
    </form>
  </div>
</div>

<% if (!rows.length) { %>
  <div class="empty">Chưa có đơn vị tổ chức nào.</div>
<% } else { %>
<div class="table-wrap">
  <table class="data atable">
    <thead>
      <tr>
        <th>Đơn vị tổ chức</th>
        <th class="c-fit">Link đăng ký cho VĐV</th>
        <th class="c-event">Giải đấu liên kết</th>
        <th class="c-fit hide-m" style="text-align: center;">Trạng thái Link</th>
        <th class="c-act" style="text-align: right;">Thao tác</th>
      </tr>
    </thead>
    <tbody>
    <% rows.forEach((o) => {
      const isExp = expired(o);
      const linkLabel = !o.active ? 'Đã khoá' : isExp ? 'Hết hạn' : 'Hoạt động';
      const linkChip = !o.active ? 'chip-muted' : isExp ? 'chip-warn' : 'chip-ok';
      const evStatus = !o.event_id ? 'Chưa tạo giải' : o.event_published ? 'Công khai' : 'Chờ duyệt';
      const evChip = !o.event_id ? 'chip-muted' : o.event_published ? 'chip-ok' : 'chip-warn';
    %>
      <tr class="at-row">
        <td class="c-main" style="vertical-align: middle;">
          <div class="stack" style="--gap: 2px;">
            <strong style="font-size: 14px;"><%= o.name %></strong>
            <span class="at-meta" style="font-size: 12px;">
              <%= [o.contact_name ? `Liên hệ: ${o.contact_name}` : null, o.phone, o.expires_at ? `Hạn: ${fmt.dateVN(o.expires_at)}` : 'Hạn: Vĩnh viễn'].filter(Boolean).join(' · ') %>
            </span>
            <% if (o.note) { %><span class="tiny faint" style="color: var(--text-dim, #888);"><%= o.note %></span><% } %>
          </div>
        </td>

        <td class="c-fit" style="vertical-align: middle;">
          <% if (o.code) { %>
            <div class="copy-bar">
              <input class="input tnum" id="reg-link-<%= o.id %>" readonly value="<%= origin %>/<%= o.code %>/dangky" spellcheck="false">
              <button type="button" class="btn btn-sm" data-copy="reg-link-<%= o.id %>" title="Chép link đăng ký">Chép</button>
            </div>
          <% } else { %>
            <span class="tiny faint">Chưa có mã</span>
          <% } %>
        </td>

        <td class="c-event" style="vertical-align: middle;">
          <% if (o.event_id) { %>
            <div class="row small" style="--gap: 8px; align-items: center; flex-wrap: nowrap;">
              <a href="/admin/giai-dau/<%= o.event_id %>" style="font-weight: 600;" title="<%= o.event_name %>">
                <%= o.event_name %>
              </a>
              <span class="chip <%= evChip %>" style="font-size: 11px; flex-shrink: 0;"><%= evStatus %></span>
              <% if (o.event_published) { %>
                <a href="/giai-dau/<%= o.event_slug %>" target="_blank" rel="noopener" class="tiny muted" title="Xem trên web">
                  <%- include('../partials/icon', { name: 'external' }) %>
                </a>
              <% } %>
            </div>
          <% } else { %>
            <span class="tiny faint">BTC chưa tạo giải</span>
          <% } %>
        </td>

        <td class="c-fit hide-m" style="vertical-align: middle; text-align: center;">
          <div class="stack" style="--gap: 2px; align-items: center;">
            <span class="chip <%= linkChip %>"><%= linkLabel %></span>
            <span class="tiny faint"><%= o.last_login_at ? fmt.dateVN(o.last_login_at) : 'Chưa đăng nhập' %></span>
          </div>
        </td>

        <!-- CỘT THAO TÁC: NÚT OPTION DROPDOWN DUY NHẤT -->
        <td class="c-act" style="vertical-align: middle; text-align: right;">
          <details class="action-dropdown">
            <summary class="btn btn-sm" aria-label="Thao tác cho <%= o.name %>">
              <span>Thao tác</span> <span style="font-size: 10px; opacity: 0.7;">▾</span>
            </summary>
            <div class="dropdown-pop">
              <button type="button" class="dropdown-item" data-modal-target="modal-edit-org-<%= o.id %>">
                <%- include('../partials/icon', { name: 'edit' }) %>
                <span>Sửa thông tin</span>
              </button>

              <% if (o.event_id) { %>
                <form method="post" action="/admin/ban-to-chuc/<%= o.id %>/duyet" data-confirm="<%= o.event_published ? 'Ẩn giải này khỏi website?' : 'Duyệt và hiện giải này trên website?' %>">
                  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                  <input type="hidden" name="published" value="<%= o.event_published ? '0' : '1' %>">
                  <button type="submit" class="dropdown-item <%= o.event_published ? '' : 'text-ok' %>">
                    <%- include('../partials/icon', { name: o.event_published ? 'close' : 'check' }) %>
                    <span><%= o.event_published ? 'Ẩn giải khỏi web' : 'Duyệt & công khai giải' %></span>
                  </button>
                </form>
              <% } %>

              <form method="post" action="/admin/ban-to-chuc/<%= o.id %>/tao-lai-link" data-confirm="Tạo lại link quản trị mới cho <%= o.name %>? Link cũ sẽ bị vô hiệu hóa ngay.">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-item">
                  <%- include('../partials/icon', { name: 'key' }) %>
                  <span>Cấp lại link</span>
                </button>
              </form>

              <form method="post" action="/admin/ban-to-chuc/<%= o.id %>/khoa" data-confirm="<%= o.active ? `Khoá link quản trị của ${o.name}?` : `Mở lại link quản trị cho ${o.name}?` %>">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <input type="hidden" name="active" value="<%= o.active ? '0' : '1' %>">
                <button type="submit" class="dropdown-item">
                  <%- include('../partials/icon', { name: 'shield' }) %>
                  <span><%= o.active ? 'Khoá link' : 'Mở khoá link' %></span>
                </button>
              </form>

              <div class="dropdown-divider"></div>

              <form method="post" action="/admin/ban-to-chuc/<%= o.id %>/xoa" data-confirm="Xoá vĩnh viễn đơn vị &quot;<%= o.name %>&quot;? Các link sẽ bị hủy. Giải đã tạo vẫn được giữ.">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-item danger">
                  <%- include('../partials/icon', { name: 'close' }) %>
                  <span>Xóa đơn vị</span>
                </button>
              </form>
            </div>
          </details>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<!-- POPUP MODALS CHỈNH SỬA CHO TỪNG ĐƠN VỊ -->
<% rows.forEach((o) => { %>
<div class="admin-modal" id="modal-edit-org-<%= o.id %>" role="dialog" aria-modal="true" aria-labelledby="modal-title-org-<%= o.id %>">
  <div class="admin-modal-content">
    <div class="admin-modal-header">
      <h3 id="modal-title-org-<%= o.id %>">Sửa thông tin đơn vị: <%= o.name %></h3>
      <button type="button" class="admin-modal-close-btn" data-modal-close aria-label="Đóng popup">✕</button>
    </div>
    <form class="form" method="post" action="/admin/ban-to-chuc/<%= o.id %>/sua">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="admin-modal-body stack" style="--gap: 12px;">
        <div class="form-grid two">
          <div class="field">
            <label for="name-<%= o.id %>">Tên đơn vị tổ chức *</label>
            <input class="input" id="name-<%= o.id %>" name="name" required maxlength="150" value="<%= o.name %>">
          </div>
          <div class="field">
            <label for="code-<%= o.id %>">Mã giải (link đăng ký) *</label>
            <input class="input" id="code-<%= o.id %>" name="code" required maxlength="40" value="<%= o.code || '' %>">
            <span class="hint">Đổi mã thì link đăng ký cũ ngừng hoạt động.</span>
          </div>
          <div class="field">
            <label for="contact-<%= o.id %>">Người liên hệ</label>
            <input class="input" id="contact-<%= o.id %>" name="contact_name" maxlength="100" value="<%= o.contact_name || '' %>">
          </div>
          <div class="field">
            <label for="phone-<%= o.id %>">SĐT liên hệ</label>
            <input class="input" id="phone-<%= o.id %>" name="phone" inputmode="tel" value="<%= o.phone || '' %>">
          </div>
          <div class="field">
            <label for="exp-<%= o.id %>">Hết hạn link quản trị</label>
            <input class="input" type="date" id="exp-<%= o.id %>" name="expires_at" value="<%= dateInput(o.expires_at) %>">
            <span class="hint">Để trống: Không giới hạn thời hạn.</span>
          </div>
          <div class="field">
            <label for="note-<%= o.id %>">Ghi chú nội bộ</label>
            <input class="input" id="note-<%= o.id %>" name="note" maxlength="1000" value="<%= o.note || '' %>">
          </div>
        </div>
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="btn btn-sm" data-modal-close>Hủy</button>
        <button class="btn btn-brand btn-sm" type="submit">Lưu thông tin</button>
      </div>
    </form>
  </div>
</div>
<% }) %>

<% } %>

<%- include('_bottom') %>