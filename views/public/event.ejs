<%- include('../partials/top', { description: `${ev.name} · ${fmt.dateVN(ev.start_date)} · ${ev.venue || ''}`, ogImage: ev.banner }) %>
<%
  const [sy, sm, sday] = String(ev.start_date || '').slice(0, 10).split('-');
  const [ey, em, eday] = String(ev.end_date || '').slice(0, 10).split('-');
  const dateStr = sday ? (sday === eday && sm === em ? `${sday}/${sm}/${sy}` : `${sday}/${sm} – ${eday}/${em}/${ey}`) : '';
  const liveNow = (ev.streams || []).filter((s) => s.status === 'live');
  const isLive = ev.status === 'ongoing' || liveNow.length > 0;
%>

<section class="page-head glow event-detail-head">
  <div class="container stack" style="--gap: 22px;">
    <div class="row" style="justify-content: space-between; align-items: center;">
      <a class="link small breadcrumb-back" href="/giai-dau">← Quay lại danh sách giải</a>
      <span class="event-official-badge">★ <%= site.site_name %> Championship Tour ★</span>
    </div>

    <!-- Grand Panoramic Hero Banner -->
    <div class="event-hero-lux-wrap">
      <div class="hero-ambient-glow" aria-hidden="true"></div>
      <%
        // Ưu tiên banner trong CMS; ảnh lỗi/mất file → app.js đổi sang ảnh mẫu theo slug
        const slugBanner = ev.slug ? `/static/img/events/${ev.slug}.svg` : '';
        const heroBanner = ev.banner || slugBanner || null;
        const heroFallback = heroBanner === slugBanner ? '' : slugBanner;
      %>
      <div class="event-hero luxury-hero">
        <% if (heroBanner) { %><img src="<%= heroBanner %>" alt="Banner <%= ev.name %>" data-fallback="<%= heroFallback %>"><% } else { %>
        <svg viewBox="0 0 800 380" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <radialGradient id="ev-glow-<%= ev.id %>" cx="80%" cy="20%" r="75%">
              <stop offset="0%" stop-color="#14B8A6" stop-opacity=".45"/>
              <stop offset="100%" stop-color="#070B14"/>
            </radialGradient>
          </defs>
          <rect width="800" height="380" fill="url(#ev-glow-<%= ev.id %>)"/>
          <g fill="none" stroke="rgba(255,255,255,.28)" stroke-width="2.5">
            <polygon points="250,60 550,60 720,380 80,380"/>
            <line x1="206" y1="150" x2="594" y2="150"/>
            <line x1="180" y1="210" x2="620" y2="210"/>
            <line x1="400" y1="60" x2="400" y2="150"/>
            <line x1="400" y1="210" x2="400" y2="380"/>
          </g>
          <circle cx="620" cy="100" r="28" fill="#D4F53C"/>
          <g fill="#3A4A00" fill-opacity=".45">
            <circle cx="612" cy="92" r="4.5"/>
            <circle cx="628" cy="96" r="4.5"/>
            <circle cx="618" cy="108" r="4.5"/>
          </g>
        </svg>
        <% } %>
        <div class="hero-glass-vignette"></div>

        <div class="hero-floating-badges">
          <% if (isLive) { %>
            <span class="chip chip-live chip-pulse"><span class="live-dot" style="background:#fff"></span>Đang diễn ra</span>
          <% } else if (ev.status === 'upcoming') { %>
            <span class="chip chip-gold-lux">Sắp khởi tranh</span>
          <% } else { %>
            <span class="chip chip-titanium">Đã bế mạc</span>
          <% } %>

          <% if (liveNow.length) { %>
            <span class="chip chip-live-sub"><%- include('../partials/icon', { name: 'live' }) %><span><%= liveNow.length %> sân đang Live</span></span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Tournament Title Header -->
    <div class="event-title-stack stack" style="--gap: 10px;">
      <span class="eyebrow gold"><%= isLive ? 'GIẢI ĐẤU ĐANG DIỄN RA TRỰC TIẾP' : ev.status === 'upcoming' ? 'GIẢI ĐẤU ĐANG MỞ ĐĂNG KÝ TRANH TÀI' : 'KẾT QUẢ GIẢI ĐẤU CHÍNH THỨC' %></span>
      <h1 class="h1 event-grand-title"><%= ev.name %></h1>
    </div>

    <!-- Luxury 4-Column Specs Ribbon -->
    <div class="lux-specs-ribbon">
      <div class="spec-card">
        <div class="spec-icon"><%- include('../partials/icon', { name: 'calendar' }) %></div>
        <div class="spec-body">
          <span class="spec-label">Thời gian thi đấu</span>
          <strong class="spec-value tnum"><%= dateStr %></strong>
          <span class="spec-sub muted"><%= ev.status === 'ongoing' ? 'Đang tranh tài sôi nổi' : ev.status === 'upcoming' ? 'Sắp mở màn khai mạc' : 'Đã kết thúc trọn vẹn' %></span>
        </div>
      </div>

      <div class="spec-card">
        <div class="spec-icon"><%- include('../partials/icon', { name: 'pin' }) %></div>
        <div class="spec-body">
          <span class="spec-label">Địa điểm & Cụm sân</span>
          <strong class="spec-value"><%= ev.venue || 'Cụm sân tiêu chuẩn' %></strong>
          <% if (ev.address) { %><span class="spec-sub muted"><%= ev.address %></span><% } %>
        </div>
      </div>

      <% if (ev.totalPrize) { %>
      <div class="spec-card spec-card-gold">
        <div class="spec-icon gold-icon">🏆</div>
        <div class="spec-body">
          <span class="spec-label gold-label">Tổng quỹ giải thưởng</span>
          <strong class="spec-value spec-gold-val"><%= ev.totalPrize %></strong>
          <span class="spec-sub gold-sub">Cúp vô địch &amp; hiện kim</span>
        </div>
      </div>
      <% } else { %>
      <div class="spec-card">
        <div class="spec-icon"><%- include('../partials/icon', { name: 'trophy' }) %></div>
        <div class="spec-body">
          <span class="spec-label">Cơ cấu thưởng</span>
          <strong class="spec-value spec-gold-val">Cúp &amp; Huy chương</strong>
          <span class="spec-sub muted">Kèm điểm thưởng ranking</span>
        </div>
      </div>
      <% } %>

      <div class="spec-card">
        <div class="spec-icon"><%- include('../partials/icon', { name: 'users' }) %></div>
        <div class="spec-body">
          <span class="spec-label">Quy mô thi đấu</span>
          <strong class="spec-value tnum"><%= ev.divisions ? ev.divisions.length : 0 %> nội dung</strong>
          <span class="spec-sub muted"><%= ev.regCount ? `${ev.regCount} đội tham gia` : 'Đang tiếp nhận đăng ký' %></span>
        </div>
      </div>
    </div>

    <!-- VIP Action Navigation Toolbar -->
    <div class="vip-action-bar">
      <% if (ev.registration_open && ev.status !== 'ended') { %>
        <a class="btn btn-brand btn-glow btn-vip-primary" href="/giai-dau/<%= ev.slug %>/dang-ky">
          <%- include('../partials/icon', { name: 'edit' }) %>
          <span>Đăng ký tham gia</span>
        </a>
      <% } %>

      <a class="btn btn-vip" href="/giai-dau/<%= ev.slug %>/danh-sach">
        <%- include('../partials/icon', { name: 'list' }) %>
        <span>Danh sách VĐV</span>
      </a>

      <a class="btn btn-vip" href="/giai-dau/<%= ev.slug %>/nhanh-dau">
        <%- include('../partials/icon', { name: 'bracket' }) %>
        <span>Nhánh đấu &amp; Lịch</span>
      </a>

      <% if (ev.streams && ev.streams.length) { %>
        <a class="btn btn-vip <%= liveNow.length ? 'btn-live btn-glow' : '' %>" href="/giai-dau/<%= ev.slug %>/truc-tiep">
          <%- include('../partials/icon', { name: 'live' }) %>
          <span><%= liveNow.length ? 'Xem Live trực tiếp' : 'Kênh Livestream' %></span>
        </a>
      <% } %>

      <% if (ev.regulation_pdf) { %>
        <a class="btn btn-vip" href="<%= ev.regulation_pdf %>" target="_blank" rel="noopener">
          <%- include('../partials/icon', { name: 'file' }) %>
          <span>Điều lệ (PDF)</span>
        </a>
      <% } %>

      <% if (ev.zalo_link) { %>
        <a class="btn btn-vip" href="<%= ev.zalo_link %>" target="_blank" rel="noopener">
          <%- include('../partials/icon', { name: 'zalo' }) %>
          <span>Nhóm Zalo</span>
        </a>
      <% } %>
    </div>

    <!-- Tournament Description Card -->
    <% if (ev.description) { %>
    <div class="lux-desc-card">
      <div class="ldc-quote-icon" aria-hidden="true">“</div>
      <p class="ldc-text"><%= ev.description %></p>
    </div>
    <% } %>
  </div>
</section>

<!-- Bục Vinh Danh Hoàng Gia (Royal 3D Stepped Podium) -->
<% if (honorDivisions && honorDivisions.length) { %>
<section class="section royal-honors-section" id="vinh-danh">
  <canvas class="honors-confetti" data-confetti aria-hidden="true"></canvas>
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow gold">BẢNG VÀNG DANH DỰ</span>
        <h2 class="h2">NHỮNG NHÀ <span class="serif gold-text">VÔ ĐỊCH</span></h2>
      </div>
      <span class="chip chip-gold-lux">★ GRAND SLAM HONORS ★</span>
    </div>

    <!-- Division Switcher for Podium (Pickna Feature) -->
    <% if (honorDivisions.length > 1) { %>
    <div class="podium-nav-tabs" role="tablist" aria-label="Chọn bảng vinh danh">
      <button type="button" class="podium-nav-btn is-active" data-podium-target="all">
        <span>🏆 Tất cả bảng đấu (<%= honorDivisions.length %>)</span>
      </button>
      <% honorDivisions.forEach((d) => { %>
        <button type="button" class="podium-nav-btn" data-podium-target="podium-div-<%= d.id %>">
          <span><%= d.name %></span>
        </button>
      <% }) %>
    </div>
    <% } %>

    <div class="stack" style="--gap: 36px;">
      <% honorDivisions.forEach((d) => { 
        const firsts = d.honors.filter((h) => h.place === 1); 
        const seconds = d.honors.filter((h) => h.place === 2); 
        const thirds = d.honors.filter((h) => h.place === 3); 
      %>
      <div class="royal-podium-card confetti stack" id="podium-div-<%= d.id %>" data-podium-card style="--gap: 20px;">
        <div class="podium-card-header">
          <span class="podium-div-crest">🏆</span>
          <h3><%= d.name %></h3>
          <span class="podium-div-sub"><%= d.subtitle || 'Vinh danh những tay vợt xuất sắc nhất' %></span>
        </div>

        <div class="royal-podium-stage">
          <%- include('../partials/honor', { h: seconds[0], cls: 'podium-col-2nd' }) %>
          <%- include('../partials/honor', { h: firsts[0], cls: 'podium-col-1st' }) %>
          <%- include('../partials/honor', { h: thirds[0], cls: 'podium-col-3rd-a' }) %>
          <% if (thirds[1]) { %>
            <%- include('../partials/honor', { h: thirds[1], cls: 'podium-col-3rd-b' }) %>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Cơ cấu giải thưởng & Các nội dung thi đấu -->
<% if (ev.divisions && ev.divisions.length) { %>
<section class="section luxury-prizes-section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">HẠNG MỤC TRANH TÀI</span>
        <h2 class="h2">CƠ CẤU GIẢI THƯỞNG <span class="serif grad-text">TỪNG NỘI DUNG</span></h2>
      </div>
      <span class="small muted"><%= ev.divisions.length %> bảng đấu chính thức</span>
    </div>

    <div class="grid prize-luxury-grid" style="--min: 320px;">
      <% ev.divisions.forEach((d) => { %>
      <article class="lux-prize-card">
        <div class="lpc-head">
          <div class="lpc-badge">BẢNG ĐẤU</div>
          <h4><%= d.name %></h4>
          <span class="lpc-sub"><%= [d.subtitle || (d.max_teams ? `Tối đa ${d.max_teams} ${d.team_type === 'team' ? 'đội' : 'đôi'}` : null), d.max_total_points && !String(d.subtitle || '').includes(fmt.pts(d.max_total_points)) ? `Tổng trình ≤ ${fmt.pts(d.max_total_points)}` : null].filter(Boolean).join(' · ') %></span>
        </div>

        <div class="lpc-prizes">
          <% (d.prizes || []).forEach((p, i) => { 
            const isGold = i === 0 || /vô địch|nhất/i.test(p.label);
            const isSilver = i === 1 || /nhì|á quân/i.test(p.label);
          %>
          <div class="lpc-row <%= isGold ? 'is-gold-row' : isSilver ? 'is-silver-row' : 'is-bronze-row' %>">
            <span class="lpc-medal-tag">
              <%= isGold ? '🥇' : isSilver ? '🥈' : '🥉' %>
              <strong><%= p.label %></strong>
            </span>
            <strong class="lpc-amount <%= isGold ? 'gold-text' : '' %>">
              <%= /^\d[\d.\s]*$/.test(p.amount) ? `${fmt.money(p.amount)} đ` : p.amount %>
            </strong>
          </div>
          <% }) %>
        </div>

        <% if (ev.registration_open && ev.status !== 'ended') { %>
        <div class="lpc-action">
          <a class="btn btn-sm btn-brand btn-glow btn-block" href="/giai-dau/<%= ev.slug %>/dang-ky?d=<%= d.id %>">
            Đăng ký nội dung này →
          </a>
        </div>
        <% } %>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (honorDivisions && honorDivisions.length) { %><script src="/static/js/confetti.js?v=<%= locals.assetV || '' %>" defer></script><% } %>
<%- include('../partials/bottom') %>
