<%- include('../partials/top') %>
<% const qs = (o) => { const p = new URLSearchParams(); const v = { gender, q, ...o }; Object.keys(v).forEach((k) => { if (v[k]) p.set(k, v[k]); }); const s = p.toString(); return s ? `?${s}` : ''; }; %>
<section class="page-head glow">
  <div class="container stack" style="--gap: 20px;">
    <div class="row ranking-hero-row" style="justify-content: space-between; align-items: center; gap: 20px;">
      <div style="flex: 1; min-width: min(100%, 260px);">
        <span class="eyebrow">BẢNG XẾP HẠNG PICKLEBALL</span>
        <h1 class="h1">BẢNG XẾP HẠNG <span class="serif grad-text">VĐV</span></h1>
        <p class="muted" style="margin-top: 8px;">Theo dõi điểm ranking và thành tích của các vận động viên.</p>
      </div>
      <% if (top) { %>
      <div class="ranking-top-paddle-slot">
        <a href="/vdv/<%= top.id %>" class="paddle-horizontal" title="Xem hồ sơ VĐV số 1 bảng xếp hạng: <%= top.full_name %>">
          <!-- Quả bóng pickleball số 01 -->
          <span class="paddle-ball" aria-hidden="true"><span>01</span></span>

          <!-- Mặt vợt Pickleball nằm ngang -->
          <div class="paddle-head">
            <div class="paddle-face">
              <span class="paddle-shade" aria-hidden="true"></span>
              <div class="h-avatar-wrap">
                <%- include('../partials/avatar', { a: top, tone: 'gold', size: 44 }) %>
              </div>
              <div class="h-meta-stack">
                <span class="top1-badge-pill">👑 TOP 1<%= gender ? ` · ${fmt.GENDER_LABEL[gender].toUpperCase()}` : '' %></span>
                <strong class="h-player-name"><%= top.full_name %></strong>
                <% if (top.club) { %><span class="h-player-sub"><%= top.club %></span><% } %>
              </div>
              <div class="h-score-stack">
                <span class="h-points"><%= fmt.pts(top.points) %></span>
                <small class="h-pts-label">ĐIỂM</small>
              </div>
            </div>
          </div>

          <!-- Cổ vợt nằm ngang -->
          <span class="paddle-throat" aria-hidden="true"></span>

          <!-- Cán vợt & Băng quấn thể thao -->
          <span class="paddle-handle" aria-hidden="true"><span class="paddle-cap"></span></span>
        </a>
      </div>
      <% } %>
    </div>
    <nav class="tabs" aria-label="Lọc theo giới tính">
      <a class="tab" href="/xep-hang<%= qs({ gender: '', page: '' }) %>" aria-current="<%= !gender %>">Tất cả</a>
      <a class="tab" href="/xep-hang<%= qs({ gender: 'M', page: '' }) %>" aria-current="<%= gender === 'M' %>">VĐV Nam</a>
      <a class="tab" href="/xep-hang<%= qs({ gender: 'F', page: '' }) %>" aria-current="<%= gender === 'F' %>">VĐV Nữ</a>
    </nav>
    <form class="row" action="/xep-hang" method="get" role="search" style="--gap: 10px; flex-wrap: nowrap;">
      <% if (gender) { %><input type="hidden" name="gender" value="<%= gender %>"><% } %>
      <label class="sr-only" for="q">Tìm vận động viên</label>
      <input class="input grow" id="q" name="q" type="search" value="<%= q %>" placeholder="Tìm tên, CLB, quê quán" autocomplete="off">
      <button class="btn btn-brand" type="submit" aria-label="Tìm"><%- include('../partials/icon', { name: 'search' }) %><span class="hide-mobile">Tìm</span></button>
    </form>
  </div>
</section>
<section style="padding-block: 16px 48px;">
  <div class="container">
    <% if (!rows.length) { %>
      <div class="empty"><%= q ? `Không tìm thấy VĐV phù hợp với "${q}".` : 'Chưa có vận động viên.' %></div>
    <% } else { %>
    <p class="tiny faint" style="margin-bottom: 10px;"><%= total %> vận động viên</p>
    <div class="rank-list">
      <% rows.forEach((a) => { %>
      <a class="rank-row" href="/vdv/<%= a.id %>">
        <span class="r tnum <%= a.rank <= 3 ? 'top gold-text' : '' %>">#<%= a.rank %></span>
        <%- include('../partials/avatar', { a, size: 44, tone: a.rank === 1 ? 'gold' : '' }) %>
        <span class="who">
          <strong style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <%= a.full_name %>
            <span aria-label="<%= fmt.GENDER_LABEL[a.gender] %>" style="display: inline; color: <%= a.gender === 'F' ? '#F472B6' : '#60A5FA' %>; font-size: 13px;"><%= a.gender === 'F' ? '♀' : '♂' %></span>
          </strong>
          <span><%= [a.nickname, a.club, a.hometown].filter(Boolean).join(' · ') %></span>
        </span>
        <span class="p"><%= fmt.pts(a.points) %><small>ĐIỂM</small></span>
      </a>
      <% }) %>
    </div>
    <% if (pages > 1) { %>
    <nav class="pager" aria-label="Phân trang">
      <% if (page > 1) { %><a href="/xep-hang<%= qs({ page: page - 1 }) %>" aria-label="Trang trước">‹</a><% } %>
      <% for (let p = Math.max(1, page - 2); p <= Math.min(pages, page + 2); p++) { %>
        <% if (p === page) { %><span aria-current="page"><%= p %></span><% } else { %><a href="/xep-hang<%= qs({ page: p }) %>"><%= p %></a><% } %>
      <% } %>
      <% if (page < pages) { %><a href="/xep-hang<%= qs({ page: page + 1 }) %>" aria-label="Trang sau">›</a><% } %>
    </nav>
    <% } %>
    <% } %>
  </div>
</section>
<%- include('../partials/bottom') %>
