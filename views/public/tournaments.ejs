<%- include('../partials/top', { pageScript: 'tournaments' }) %>
<%
  const tabs = [
    ['all', 'Tất cả', groups.all.length, 'Tất cả'],
    ['ongoing', 'Đang diễn ra', groups.ongoing.length, 'Đang đấu'],
    ['upcoming', 'Sắp diễn ra', groups.upcoming.length, 'Sắp tới'],
    ['ended', 'Đã kết thúc', groups.ended.length, 'Kết thúc']
  ];
  const currentTabObj = tabs.find((t) => t[0] === tab) || tabs[0];
  const currentEvents = groups[tab] || [];
  const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' });
%>

<section class="page-head glow" style="padding-block: 22px 18px;">
  <div class="container stack" style="--gap: 12px;">
    <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <span class="eyebrow" style="margin: 0;"><span class="brand-dot"></span>HỆ THỐNG GIẢI ĐẤU</span>
      <span class="tiny faint"><%= site.site_name %> Championship Tour</span>
    </div>
    <div class="row" style="justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 10px;">
      <div>
        <h1 class="h1" style="font-size: clamp(26px, 5.5vw, 36px); margin: 0; line-height: 1.15;">Giải Đấu Pickleball</h1>
        <p class="muted small" style="margin-top: 4px;">Theo dõi lịch thi đấu, sơ đồ nhánh đấu và kết quả các giải đấu</p>
      </div>
    </div>
  </div>
</section>

<section class="tx-main" id="danh-sach-giai" style="padding-top: 14px;">
  <div class="container stack" style="--gap: 18px;">
    <!-- Thanh điều khiển: Tab lọc trạng thái + Tìm kiếm -->
    <div class="tx-controls">
      <nav class="tx-tabs" aria-label="Lọc giải đấu">
        <% tabs.forEach(([k, label, count, short]) => { %>
          <a class="tx-tab<%= tab === k ? ' is-active' : '' %>" href="/giai-dau?tab=<%= k %>#danh-sach-giai" aria-label="<%= label %> (<%= count %>)"<% if (tab === k) { %> aria-current="page"<% } %>>
            <span class="tx-tab-full" aria-hidden="true"><%= label %></span><span class="tx-tab-short" aria-hidden="true"><%= short %></span><b class="tnum" aria-hidden="true"><%= count %></b>
          </a>
        <% }) %>
      </nav>
      <label class="tx-search">
        <%- include('../partials/icon', { name: 'search' }) %>
        <span class="sr-only">Tìm giải đấu</span>
        <input type="search" id="tourSearchInput" placeholder="Tìm tên giải, cụm sân, địa điểm…" autocomplete="off" spellcheck="false">
      </label>
    </div>

    <!-- Thông báo khi tìm kiếm không có kết quả -->
    <div id="searchEmptyMessage" class="tx-empty" style="display: none;">
      <span class="tx-empty-ball" aria-hidden="true"></span>
      <p>Không tìm thấy giải đấu nào khớp với từ khóa.</p>
      <button type="button" class="btn btn-sm btn-lux-outline" data-search-clear>Xóa tìm kiếm</button>
    </div>

    <!-- Danh sách toàn cảnh giải đấu -->
    <% if (!currentEvents.length) { %>
      <div class="tx-empty">
        <span class="tx-empty-ball" aria-hidden="true"></span>
        <p>Hiện chưa có giải đấu nào trong mục <strong><%= currentTabObj[1] %></strong>.</p>
        <a class="btn btn-sm btn-brand" href="/giai-dau?tab=all#danh-sach-giai">Xem tất cả giải đấu</a>
      </div>
    <% } else { %>
      <div class="tx-grid" id="tournamentGrid">
        <% currentEvents.forEach((e) => { %><%- include('../partials/tour-card', { e, today }) %><% }) %>
      </div>

      <div class="tx-more" data-load-more-wrap hidden>
        <button type="button" class="tx-more-btn" data-load-more aria-controls="tournamentGrid">Xem thêm <b class="tnum" data-load-more-count></b> giải</button>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/bottom', { pageScript: 'tournaments' }) %>
