<%- include('../partials/top', { cropper: true }) %>
<section class="page-head glow">
  <div class="container stack" style="--gap: 10px; max-width: 1100px;">
    <span class="eyebrow">TỰ CHẤM TRÌNH VẬN ĐỘNG VIÊN</span>
    <h1 class="h1">TỰ CHẤM TRÌNH <span class="serif grad-text">VẬN ĐỘNG VIÊN</span></h1>
    <p class="muted">Gửi điểm tự chấm để ban tổ chức kiểm tra và duyệt. Mốc tối thiểu: Nam <%= fmt.pts(floors.M) %>, Nữ <%= fmt.pts(floors.F) %>.</p>
  </div>
</section>
<section style="padding-block: 16px 56px;">
  <div class="container" style="max-width: 1100px;">
    <% if (done) { %>
    <div class="card card-pad stack" style="--gap: 14px; text-align: center; align-items: center;">
      <span class="chip chip-brand">Đã gửi đơn</span>
      <h2 style="font-size: 26px; font-weight: 800;">Cảm ơn bạn!</h2>
      <p class="muted">Đơn chấm trình đang chờ ban tổ chức duyệt. Khi được duyệt, bạn sẽ xuất hiện trên bảng xếp hạng.</p>
      <a class="btn btn-brand" href="/xep-hang">Xem bảng xếp hạng</a>
    </div>
    <% } else { %>
    <div style="display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); align-items: start;">
      <aside class="card card-pad stack" style="--gap: 12px;">
        <h2 style="font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em;">ĐIỀU KIỆN GỬI ĐƠN</h2>
        <p class="small muted">Điền đúng thông tin thật, chọn ảnh rõ mặt và tự chấm điểm phù hợp trình độ hiện tại.</p>
        <div class="info-tile"><span><strong>VĐV Nam</strong><br><span class="small muted">Nhận đơn từ mốc <%= fmt.pts(floors.M) %></span></span></div>
        <div class="info-tile"><span><strong>VĐV Nữ</strong><br><span class="small muted">Nhận đơn từ mốc <%= fmt.pts(floors.F) %></span></span></div>
        <div class="info-tile"><span><strong>Số điện thoại</strong><br><span class="small muted">Số di động Việt Nam, chưa có trong hệ thống<%= otpEnabled ? ', xác minh bằng OTP' : '' %></span></span></div>
      </aside>
      <form class="card card-pad form" method="post" action="/cham-trinh" enctype="multipart/form-data" data-once novalidate>
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <h2 style="font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em;">GỬI ĐƠN CHẤM TRÌNH</h2>
        <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
        <div class="form-grid two">
          <div class="field span-2"><label for="full_name">Họ và tên *</label><input class="input" id="full_name" name="full_name" required maxlength="80" autocomplete="name" value="<%= values.full_name || '' %>"></div>
          <div class="field"><label for="nickname">Nickname</label><input class="input" id="nickname" name="nickname" maxlength="40" value="<%= values.nickname || '' %>"></div>
          <div class="field"><span class="label">Giới tính *</span>
            <div class="segmented" role="radiogroup" aria-label="Giới tính">
              <label><input type="radio" name="gender" value="M" <%= values.gender !== 'F' ? 'checked' : '' %>><span>Nam</span></label>
              <label><input type="radio" name="gender" value="F" <%= values.gender === 'F' ? 'checked' : '' %>><span>Nữ</span></label>
            </div>
          </div>
          <div class="field"><label for="phone">Số điện thoại *</label><input class="input" id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="16" required data-phone value="<%= values.phone || '' %>" placeholder="09xx xxx xxx"><span class="hint" data-phone-hint data-default="Số di động Việt Nam 10 số"></span></div>
          <div class="field"><label for="ranking_points">Điểm tự chấm *</label><input class="input tnum" id="ranking_points" name="ranking_points" inputmode="decimal" required placeholder="Ví dụ 2.750" value="<%= values.points || '' %>"></div>
          <div class="field"><label for="hometown">Quê quán *</label><input class="input" id="hometown" name="hometown" required maxlength="80" value="<%= values.hometown || '' %>"></div>
          <div class="field"><label for="club">Câu lạc bộ *</label><input class="input" id="club" name="club" required maxlength="80" value="<%= values.club || '' %>"></div>
          <div class="field span-2"><label for="description">Mô tả thêm</label><textarea class="input" id="description" name="description" maxlength="1000" placeholder="Trình độ, thành tích, ghi chú…"><%= values.description || '' %></textarea></div>
        </div>
        <%- include('../partials/avatar-crop', { required: true }) %>
        <% if (otpEnabled) { %><%- include('../partials/otp', { purpose: 'submission', phoneInput: 'phone' }) %><% } %>
        <label class="check"><input type="checkbox" name="consent" value="1" required><span>Tôi đồng ý cho ban tổ chức xử lý họ tên, số điện thoại và ảnh để xét duyệt và hiển thị trên bảng xếp hạng, theo <a class="link" href="/chinh-sach-quyen-rieng-tu" target="_blank">chính sách quyền riêng tư</a>.</span></label>
        <button class="btn btn-brand btn-lg btn-block" type="submit">Gửi đơn chấm trình</button>
      </form>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/bottom', { cropper: true }) %>
