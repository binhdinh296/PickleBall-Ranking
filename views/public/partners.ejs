<%- include('../partials/top') %>
<section class="page-head glow">
  <div class="container stack" style="--gap: 10px;">
    <span class="eyebrow">Đối tác</span>
    <h1 class="h1">Đối tác <span class="serif grad-text">đồng hành</span></h1>
    <p class="muted">Cảm ơn các đơn vị đã đồng hành cùng cộng đồng Pickleball.</p>
  </div>
</section>
<section style="padding-block: 16px 56px;">
  <div class="container">
    <% if (!partners.length) { %><div class="empty">Danh sách đối tác đang được cập nhật.</div><% } else { %>
    <div class="grid" style="--min: 200px;">
      <% partners.forEach((p) => { %>
      <a class="card card-pad stack" style="--gap: 12px; align-items: center; text-align: center;" href="<%= p.url || '#' %>" <%- p.url ? 'target="_blank" rel="noopener"' : '' %>>
        <span class="partner" style="width: 100%; height: 100px; border: 0;"><% if (p.logo) { %><img src="<%= p.logo %>" alt=""><% } else { %><%= p.name %><% } %></span>
        <strong><%= p.name %></strong>
      </a>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/bottom') %>
