<%- include('../partials/top') %>
<section class="page-head glow">
  <div class="container stack" style="--gap: 10px;">
    <span class="eyebrow">ĐỐI TÁC ĐỒNG HÀNH</span>
    <h1 class="h1">ĐỐI TÁC <span class="serif grad-text">ĐỒNG HÀNH</span></h1>
    <p class="muted">Cảm ơn các đơn vị đã đồng hành cùng cộng đồng Pickleball.</p>
  </div>
</section>
<section style="padding-block: 16px 56px;">
  <div class="container">
    <% if (!partners.length) { %><div class="empty">Danh sách đối tác đang được cập nhật.</div><% } else { %>
    <ul class="sponsors-grid">
      <% partners.forEach((p) => { %>
      <li class="sponsors-card">
        <%- include('../partials/partner-tile', { p, hidden: false }) %>
        <strong><%= p.name %></strong>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>
</section>
<%- include('../partials/bottom') %>
