<%- include('../partials/top') %>
<section class="page-head glow">
  <div class="container stack" style="--gap: 18px;">
    <%- include('../partials/event-nav', { current: 'bracket' }) %>
    <div><span class="eyebrow">NHÁNH ĐẤU</span><h1 class="h1" style="font-size: clamp(26px, 6.5vw, 42px);"><%= d ? d.name : ev.name %></h1>
      <% if (d && d.format === 'roundrobin') { %><p class="muted small" style="margin-top: 6px;"><%= data.teams.length %> đội<%= d.relay_legs ? ` · ${d.relay_legs} chặng · chạm ${d.relay_legs * d.relay_step}` : '' %> · vòng tròn</p><% } %>
    </div>
    <%- include('../partials/division-tabs') %>
  </div>
</section>
<section style="padding-block: 8px 56px;">
  <div class="container stack bk-page" style="--gap: 20px;" <% if (d) { %>data-version-url="/api/divisions/<%= d.id %>/version" data-version="<%= data.version %>" <%= data.stats.live ? 'data-has-live' : '' %><% } %>>
    <% if (!d) { %><div class="empty">Giải chưa có nội dung thi đấu.</div>
    <% } else if (!data.matches.length) { %><div class="empty">Chưa có nhánh đấu cho nội dung này.</div>
    <% } else { %>
    <div class="stat-tiles">
      <div class="stat-tile"><b><%= data.stats.total %></b><span>Tổng trận</span></div>
      <div class="stat-tile"><b style="color: var(--live);"><%= data.stats.live %></b><span>Đang đấu</span></div>
      <div class="stat-tile"><b><%= data.stats.done %></b><span>Hoàn thành</span></div>
    </div>

    <% if (data.table) { %>
    <section class="stage-section" aria-label="Bảng đấu vòng tròn">
      <div class="stage-header-card stage-group-header">
        <div class="stage-header-left">
          <div class="stage-pill stage-pill-group">
            <%- include('../partials/icon', { name: 'bracket' }) %>
            <span>BẢNG ĐẤU · TÍNH ĐIỂM</span>
          </div>
          <h2 class="stage-header-title">BẢNG XẾP HẠNG VÒNG TRÒN</h2>
        </div>
        <div class="stage-criteria-pills">
          <span class="crit-pill">1. Số trận thắng</span>
          <span class="crit-pill">2. Hiệu số điểm</span>
          <span class="crit-pill">3. Đối đầu / Bảng phụ</span>
          <span class="crit-pill crit-pill-muted">Hòa: Bốc thăm</span>
        </div>
      </div>
      <div class="card card-pad stack" style="--gap: 14px;">
        <div class="table-wrap">
          <table class="data standings-table">
            <thead>
              <tr>
                <th style="width: 58px; text-align: center;">Hạng</th>
                <th>Đội / Vận động viên</th>
                <th class="num">Trận</th>
                <th class="num">Thắng</th>
                <th class="num">Thua</th>
                <th class="num">Ghi</th>
                <th class="num">Thua</th>
                <th class="num">Hiệu số</th>
                <th>Căn cứ xếp hạng</th>
              </tr>
            </thead>
            <tbody>
              <% data.table.rows.forEach((r) => { const t = data.teamMap[r.id]; %>
              <tr class="<%= r.rank === 1 ? 'is-leader' : r.rank <= 2 ? 'is-qualifier' : '' %>">
                <td data-label="Hạng" style="text-align: center;">
                  <span class="rank-badge rank-<%= r.rank %>"><%= r.rank %></span>
                </td>
                <td data-label="Đội">
                  <strong class="team-name"><%= t.name %></strong>
                  <% if (t.members) { %>
                    <details style="margin-top: 4px;">
                      <summary class="tiny faint" style="cursor: pointer;">Xem thành viên</summary>
                      <span class="tiny muted" style="white-space: pre-line;"><%= t.members %></span>
                    </details>
                  <% } %>
                </td>
                <td data-label="Trận" class="num"><%= r.played %></td>
                <td data-label="Thắng" class="num"><strong class="stat-win"><%= r.wins %></strong></td>
                <td data-label="Thua" class="num"><%= r.losses %></td>
                <td data-label="Điểm ghi" class="num"><%= r.pf %></td>
                <td data-label="Điểm thua" class="num"><%= r.pa %></td>
                <td data-label="Hiệu số" class="num"><strong class="<%= r.diff > 0 ? 'diff-pos' : r.diff < 0 ? 'diff-neg' : '' %>"><%= r.diff > 0 ? '+' : '' %><%= r.diff %></strong></td>
                <td data-label="Căn cứ" class="tiny faint"><%= r.basis %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% data.table.subTables.forEach((s) => { %>
        <div class="card sub-table-card" style="padding: 12px 14px; border-radius: var(--r-md);">
          <strong class="small" style="color: var(--court);">Bảng phụ <%= s.rows.length %> đội · <%= s.basis %></strong>
          <p class="tiny faint" style="margin-top: 2px;">Cùng <%= s.wins %> trận thắng, hiệu số tổng <%= s.diff > 0 ? '+' : '' %><%= s.diff %>.</p>
          <div class="stack" style="--gap: 6px; margin-top: 8px;">
            <% s.rows.forEach((r) => { %>
              <div class="row small" style="justify-content: space-between; border-bottom: 1px dashed var(--line); padding-bottom: 4px;">
                <span><%= data.teamMap[r.id].name %></span>
                <span class="tnum font-mono"><b><%= r.wins %></b> thắng · <b><%= r.diff > 0 ? '+' : '' %><%= r.diff %></b></span>
              </div>
            <% }) %>
          </div>
        </div>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (d.format === 'roundrobin') { %>
    <section class="stage-section" aria-label="Lịch thi đấu theo lượt">
      <div class="stage-header-card stage-schedule-header">
        <div class="stage-header-left">
          <div class="stage-pill stage-pill-schedule">
            <%- include('../partials/icon', { name: 'time' }) %>
            <span>LỊCH THI ĐẤU · THEO LƯỢT</span>
          </div>
          <h2 class="stage-header-title">DANH SÁCH CÁC LƯỢT ĐẤU</h2>
        </div>
      </div>
      <div class="stack" style="--gap: 18px;">
        <% data.rounds.forEach((r) => { %>
        <div class="stack" style="--gap: 10px;">
          <div class="schedule-round-title">
            <span class="schedule-round-pill"><%= r.name %></span>
            <span class="tiny faint"><%= r.matches.length %> trận đấu</span>
          </div>
          <div class="grid" style="--min: 260px; gap: 10px;">
            <% r.matches.forEach((m) => { %><%- include('../partials/match-card', { m, teamMap: data.teamMap, streams: data.streams }) %><% }) %>
          </div>
        </div>
        <% }) %>
      </div>
    </section>
    <% } else {
      // Nhà vô địch: đội thắng trận cuối của sơ đồ chính (cột cuối chỉ có 1 trận)
      const last = data.board.columns[data.board.columns.length - 1];
      const fm = last && last.matches.length === 1 ? last.matches[0] : null;
      let champ = null;
      if (fm && fm.status === 'done') {
        const ta = fm.team_a_id ? data.teamMap[fm.team_a_id] : null, tb = fm.team_b_id ? data.teamMap[fm.team_b_id] : null;
        const aWin = ta && (!tb || (fm.score_a ?? -1) > (fm.score_b ?? -1));
        champ = aWin ? (fm.players_a || ta.name) : tb ? (fm.players_b || tb.name) : null;
      }
    %>
    <section class="stage-section" aria-label="Sơ đồ nhánh đấu">
      <% if (champ) { %><div class="bk-champ"><%- include('../partials/icon', { name: 'trophy' }) %><span>Vô địch</span><strong><%= champ %></strong></div><% } %>
      <%- include('../partials/bracket-board', { board: data.board, teamMap: data.teamMap, teamNo: data.teamNo, streams: data.streams, d, ev }) %>
    </section>
    <% } %>
    <% } %>
  </div>
</section>
<%- include('../partials/bottom') %>
