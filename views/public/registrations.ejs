<%- include('../partials/top') %>
<section class="page-head glow">
  <div class="container stack" style="--gap: 18px;">
    <%- include('../partials/event-nav', { current: 'list' }) %>
    <div><span class="eyebrow">DANH SÁCH ĐĂNG KÝ</span><h1 class="h1" style="font-size: clamp(26px, 6.5vw, 42px);"><%= d ? d.name : ev.name %></h1></div>
    <%- include('../partials/division-tabs') %>
  </div>
</section>
<section style="padding-block: 8px 56px;">
  <div class="container">
    <% if (!d) { %><div class="empty">Giải chưa có nội dung thi đấu.</div>
    <% } else if (!regs.length) { %><div class="empty">Chưa có đăng ký cho nội dung này.</div>
    <% } else { %>
    <p class="tiny faint" style="margin-bottom: 10px;"><%= regs.length %><%= d.max_teams ? `/${d.max_teams}` : '' %> <%= d.team_type === 'team' ? 'đội' : 'đôi' %> · <%= regs.filter((r) => r.status === 'approved').length %> đã duyệt</p>
    <div class="table-wrap">
      <table class="data table-reg">
        <thead>
          <tr>
            <th class="col-stt tnum">STT</th>
            <th class="col-v1"><span class="hide-desktop">VĐV 1</span><span class="hide-mobile">Vận động viên 1</span></th>
            <th class="col-v2"><span class="hide-desktop">VĐV 2</span><span class="hide-mobile">Vận động viên 2</span></th>
            <th class="col-pts num"><span class="hide-desktop">Trình</span><span class="hide-mobile">Tổng trình</span></th>
            <th class="col-status"><span class="hide-desktop">T.Thái</span><span class="hide-mobile">Trạng thái</span></th>
          </tr>
        </thead>
        <tbody>
          <% regs.forEach((r, i) => { %>
          <tr>
            <td class="col-stt tnum"><%= i + 1 %></td>
            <td class="col-v1">
              <% if (r.athlete1_id) { %><a class="link" href="/vdv/<%= r.athlete1_id %>"><%= r.name1 %></a><% } else { %><span><%= r.name1 %></span><% } %>
            </td>
            <td class="col-v2">
              <% if (r.athlete2_id) { %><a class="link" href="/vdv/<%= r.athlete2_id %>"><%= r.name2 %></a><% } else { %><span class="<%= r.name2 ? '' : 'muted' %>"><%= r.name2 || '—' %></span><% } %>
            </td>
            <td class="col-pts num">
              <% if (r.points1 != null && r.points2 != null && (r.points1 > 0 || r.points2 > 0)) { %>
                <strong><%= fmt.pts(r.points1 + r.points2) %></strong>
              <% } else { %>
                <span class="muted">—</span>
              <% } %>
            </td>
            <td class="col-status">
              <span class="chip-mini <%= r.status === 'approved' ? 'chip-ok' : 'chip-warn' %>"><%= fmt.REG_STATUS_LABEL[r.status] || (r.status === 'approved' ? 'Đã duyệt' : 'Chờ duyệt') %></span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/bottom') %>
