<%# Nút chọn giao diện: 4 theme, có ô màu xem trước. Tham số: paletteIcon (SVG) %>
<div class="theme-menu" data-theme-menu>
  <button type="button" class="icon-btn" data-theme-btn aria-haspopup="true" aria-expanded="false" aria-controls="theme-pop" aria-label="Chọn giao diện" title="Chọn giao diện"><%- paletteIcon %></button>
  <div class="theme-pop" id="theme-pop" role="menu" aria-label="Giao diện" hidden>
    <p class="theme-pop-title" aria-hidden="true">Giao diện</p>
    <% themes.THEMES.forEach(function (t) { %>
    <button type="button" class="theme-opt" role="menuitemradio" aria-checked="false" data-theme-opt="<%= t.id %>">
      <span class="tsw tsw-<%= t.id %>" aria-hidden="true"></span>
      <span class="theme-opt-text"><strong><%= t.name %></strong><small><%= t.desc %></small></span>
      <svg class="theme-opt-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <% }) %>
  </div>
</div>
