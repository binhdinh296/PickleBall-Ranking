<%
  const [sy, sm, sday] = String(e.start_date || '').slice(0, 10).split('-');
  const [ey, em, eday] = String(e.end_date || '').slice(0, 10).split('-');
  const dateStr = sday ? (sday === eday && sm === em ? `${sday}/${sm}/${sy}` : `${sday}/${sm} – ${eday}/${em}/${ey}`) : '';
  const isLive = e.status === 'ongoing' || (e.liveCount && e.liveCount > 0);
  const bannerImg = (e.banner && !e.banner.startsWith('/uploads/')) ? e.banner : (e.slug ? `/static/img/events/${e.slug}.svg` : null);
%>
<article class="ecard luxury-ecard <%= isLive ? 'is-live' : e.status === 'upcoming' ? 'is-upcoming' : 'is-ended' %>" data-event-card data-name="<%= (e.name || '').toLowerCase() %>" data-venue="<%= (e.venue || '').toLowerCase() %>" data-status="<%= e.status %>">
  <div class="ecard-ambient" aria-hidden="true"></div>

  <!-- Cover Image with Grand Vignette -->
  <a class="cover" href="/giai-dau/<%= e.slug %>" aria-label="<%= e.name %>">
    <% if (bannerImg) { %>
      <img src="<%= bannerImg %>" alt="<%= e.name %>" loading="lazy">
    <% } else { %>
    <svg viewBox="0 0 400 200" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <radialGradient id="fc-glow-<%= e.id %>" cx="80%" cy="20%" r="75%">
          <stop offset="0%" stop-color="#14B8A6" stop-opacity=".45"/>
          <stop offset="100%" stop-color="#070B14"/>
        </radialGradient>
      </defs>
      <rect width="400" height="200" fill="url(#fc-glow-<%= e.id %>)"/>
      <g fill="none" stroke="rgba(255,255,255,.28)" stroke-width="1.8">
        <polygon points="120,34 280,34 362,200 38,200"/>
        <line x1="98" y1="78" x2="302" y2="78"/>
        <line x1="82" y1="112" x2="318" y2="112"/>
        <line x1="200" y1="34" x2="200" y2="78"/>
        <line x1="200" y1="112" x2="200" y2="200"/>
      </g>
      <circle cx="310" cy="52" r="14" fill="#D4F53C"/>
      <g fill="#3A4A00" fill-opacity=".45">
        <circle cx="306" cy="48" r="2.2"/>
        <circle cx="314" cy="50" r="2.2"/>
        <circle cx="309" cy="56" r="2.2"/>
      </g>
    </svg>
    <% } %>
    <div class="cover-overlay"></div>

    <!-- Ticket-style Date Badge -->
    <% if (sday && sm) { %>
    <div class="date-badge" aria-hidden="true">
      <span class="db-month">THG <%= parseInt(sm, 10) %></span>
      <span class="db-day"><%= sday %></span>
    </div>
    <% } %>

    <!-- Status Badges (Matching Pickna LIVE / COMING / DONE) -->
    <div class="cover-chips">
      <% if (isLive) { %>
        <span class="chip chip-live chip-pulse"><span class="live-dot" style="background:#fff"></span>Đang diễn ra</span>
      <% } else if (e.status === 'upcoming') { %>
        <span class="chip chip-gold-lux">Sắp diễn ra</span>
      <% } else { %>
        <span class="chip chip-titanium">Đã kết thúc</span>
      <% } %>
      <% if (e.liveCount && e.liveCount > 0) { %>
        <span class="chip chip-live-sub"><%- include('icon', { name: 'live' }) %><span><%= e.liveCount %> sân Live</span></span>
      <% } %>
    </div>
  </a>

  <!-- Card Body -->
  <div class="body">
    <div class="head-row">
      <span class="event-tag"><%= isLive ? '🔥 GIẢI ĐẤU ĐANG DIỄN RA' : e.status === 'upcoming' ? '⚡ MỞ ĐĂNG KÝ TRANH TÀI' : '✨ BẢNG VÀNG DANH DỰ' %></span>
      <h3 class="tournament-title"><a href="/giai-dau/<%= e.slug %>"><%= e.name %></a></h3>
    </div>

    <!-- Division Tags List (Pickna Hallmark Feature) -->
    <% if (e.divisions && e.divisions.length) { %>
    <div class="tournament-tags" aria-label="Nội dung thi đấu">
      <% e.divisions.slice(0, 4).forEach((d) => { %>
        <span class="tournament-tag"><%= d.name %></span>
      <% }) %>
      <% if (e.divisions.length > 4) { %>
        <span class="tournament-tag more">+<%= e.divisions.length - 4 %> nội dung</span>
      <% } %>
    </div>
    <% } %>

    <!-- Prize Pool Pill -->
    <% if (e.totalPrize) { %>
    <div class="prize-pill">
      <span class="pp-icon">🏆</span>
      <span class="pp-text">Tổng giải thưởng:</span>
      <strong class="pp-amount"><%= e.totalPrize %></strong>
    </div>
    <% } %>

    <!-- Meta Information Rows -->
    <div class="tournament-info meta">
      <div class="tournament-info-row">
        <%- include('icon', { name: 'calendar' }) %>
        <span><%= dateStr %></span>
      </div>
      <% if (e.venue) { %>
      <div class="tournament-info-row">
        <%- include('icon', { name: 'pin' }) %>
        <span><%= e.venue %></span>
      </div>
      <% } %>
      <div class="tournament-info-row">
        <%- include('icon', { name: 'trophy' }) %>
        <span><%= e.divisionCount || (e.divisions ? e.divisions.length : 0) %> nội dung thi đấu<% if (e.regCount) { %> · <strong style="color: var(--text)"><%= e.regCount %> đội đăng ký</strong><% } %></span>
      </div>
    </div>

    <!-- Full-Width Golden Grand CTA Bar (Pickna Feature) -->
    <a class="tournament-cta" href="/giai-dau/<%= e.slug %>">
      <span><%= isLive ? 'Xem Trực Tiếp & Bảng Đấu' : (e.registration_open && e.status !== 'ended') ? 'Đăng Ký Tranh Tài Ngay' : e.status === 'ended' ? 'Xem Bảng Vàng & Kết Quả' : 'Chọn Giải Đấu' %></span>
      <span class="tcta-arrow" aria-hidden="true">→</span>
    </a>

    <!-- Quick Action Secondary Navigation -->
    <div class="ecard-quick-actions">
      <a class="qa-link" href="/giai-dau/<%= e.slug %>/danh-sach">Danh sách VĐV</a>
      <span class="qa-sep">•</span>
      <a class="qa-link" href="/giai-dau/<%= e.slug %>/nhanh-dau">Nhánh đấu</a>
      <% if (e.liveCount && e.liveCount > 0) { %>
        <span class="qa-sep">•</span>
        <a class="qa-link qa-live" href="/giai-dau/<%= e.slug %>/truc-tiep">Live (<%= e.liveCount %>)</a>
      <% } else if (e.status === 'ended') { %>
        <span class="qa-sep">•</span>
        <a class="qa-link qa-gold" href="/giai-dau/<%= e.slug %>#vinh-danh">Bục vinh danh</a>
      <% } %>
    </div>
  </div>
</article>
