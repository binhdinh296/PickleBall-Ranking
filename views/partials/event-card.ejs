<%
  const [sy, sm, sday] = String(e.start_date || '').slice(0, 10).split('-');
  const [ey, em, eday] = String(e.end_date || '').slice(0, 10).split('-');
  const dateStr = sday ? (sday === eday && sm === em ? `${sday}/${sm}/${sy}` : `${sday}/${sm} – ${eday}/${em}/${ey}`) : '';
  const isLive = e.status === 'ongoing' || (e.liveCount && e.liveCount > 0);
%>
<article class="ecard luxury-ecard <%= isLive ? 'is-live' : e.status === 'upcoming' ? 'is-upcoming' : 'is-ended' %>">
  <div class="ecard-ambient" aria-hidden="true"></div>
  <a class="cover" href="/giai-dau/<%= e.slug %>" aria-label="<%= e.name %>">
    <% if (e.banner) { %><img src="<%= e.banner %>" alt="" loading="lazy"><% } else { %>
    <svg viewBox="0 0 400 200" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="rgba(255,255,255,.25)" stroke-width="1.5"><polygon points="120,34 280,34 362,200 38,200"/><line x1="98" y1="78" x2="302" y2="78"/><line x1="82" y1="112" x2="318" y2="112"/></g></svg>
    <% } %>
    <div class="cover-overlay"></div>

    <% if (sday && sm) { %>
    <div class="date-badge" aria-hidden="true">
      <span class="db-month">THG <%= parseInt(sm, 10) %></span>
      <span class="db-day"><%= sday %></span>
    </div>
    <% } %>

    <div class="cover-chips">
      <% if (isLive) { %>
        <span class="chip chip-live chip-pulse"><span class="live-dot" style="background:#fff"></span>Đang diễn ra</span>
      <% } else if (e.status === 'upcoming') { %>
        <span class="chip chip-gold-lux">Sắp diễn ra</span>
      <% } else { %>
        <span class="chip chip-titanium">Đã kết thúc</span>
      <% } %>
      <% if (e.liveCount && e.liveCount > 0) { %>
        <span class="chip chip-live-sub"><%- include('icon', { name: 'live' }) %><%= e.liveCount %> sân Live</span>
      <% } %>
    </div>
  </a>

  <div class="body">
    <div class="head-row">
      <span class="event-tag"><%= isLive ? '🔥 GIẢI ĐẤU ĐANG DIỄN RA' : e.status === 'upcoming' ? '⚡ MỞ ĐĂNG KÝ TRANH TÀI' : '✨ BẢNG VÀNG DANH DỰ' %></span>
      <h3><a href="/giai-dau/<%= e.slug %>"><%= e.name %></a></h3>
    </div>

    <% if (e.totalPrize) { %>
    <div class="prize-pill">
      <span class="pp-icon">🏆</span>
      <span class="pp-text">Tổng giải thưởng:</span>
      <strong class="pp-amount"><%= e.totalPrize %></strong>
    </div>
    <% } %>

    <div class="meta">
      <span><%- include('icon', { name: 'calendar' }) %><%= dateStr %></span>
      <% if (e.venue) { %><span><%- include('icon', { name: 'pin' }) %><%= e.venue %></span><% } %>
      <span><%- include('icon', { name: 'trophy' }) %><%= e.divisionCount || 0 %> nội dung thi đấu<% if (e.regCount) { %> · <strong style="color: var(--text)"><%= e.regCount %> đội đăng ký</strong><% } %></span>
    </div>

    <div class="actions">
      <% if (e.liveCount && e.liveCount > 0) { %>
        <a class="btn btn-live btn-sm btn-glow" href="/giai-dau/<%= e.slug %>/truc-tiep"><%- include('icon', { name: 'live' }) %>Xem Live</a>
        <a class="btn btn-sm btn-lux-outline" href="/giai-dau/<%= e.slug %>/nhanh-dau">Nhánh đấu</a>
      <% } else if (e.status === 'ended') { %>
        <a class="btn btn-gold-lux btn-sm btn-glow" href="/giai-dau/<%= e.slug %>#vinh-danh"><%- include('icon', { name: 'trophy' }) %>Bục vinh danh</a>
        <a class="btn btn-sm btn-lux-outline" href="/giai-dau/<%= e.slug %>/nhanh-dau">Kết quả</a>
      <% } else { %>
        <% if (e.registration_open) { %>
          <a class="btn btn-brand btn-sm btn-glow" href="/giai-dau/<%= e.slug %>/dang-ky">Đăng ký ngay</a>
        <% } else { %>
          <a class="btn btn-brand btn-sm" href="/giai-dau/<%= e.slug %>">Xem chi tiết</a>
        <% } %>
        <a class="btn btn-sm btn-lux-outline" href="/giai-dau/<%= e.slug %>">Thông tin</a>
      <% } %>
    </div>
  </div>
</article>
