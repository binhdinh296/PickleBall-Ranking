<div class="otp-box" data-otp="<%= purpose %>" data-phone-input="<%= phoneInput %>">
  <div class="row" style="--gap: 10px; justify-content: space-between;">
    <span class="label"><%- include('icon', { name: 'shield', size: 16 }) %> Xác minh số điện thoại<%= locals.who ? ` (${who})` : '' %></span>
    <button type="button" class="btn btn-sm" data-otp-send>Gửi mã OTP</button>
  </div>
  <div class="field">
    <label for="otp_code" class="sr-only">Mã OTP 6 số</label>
    <input class="input otp-input" id="otp_code" name="otp_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="••••••" data-otp-code required>
    <span class="hint" data-otp-msg aria-live="polite">Bấm "Gửi mã OTP", nhập mã 6 số nhận qua tin nhắn.</span>
  </div>
</div>
